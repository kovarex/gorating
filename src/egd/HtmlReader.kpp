// A tolerant reader of the European Go Database's pages, standing in for PHP's DOMDocument::loadHTML
// (libxml2's HTML parser) in what the PHP version read with it: elements by tag in document order,
// their attributes, and their text (nodeValue). Not a full HTML parser: it keeps the tree libxml2
// builds for EGD's pages, which the PHP version's egd_extract.php was compared with on saved pages (in git's history).
//
// The rules: void elements have no content; an end tag closes back to its open element (and is
// ignored when none is open); a <td> or <th> closes the open cell of its row, a <tr> the open row
// of its table, an <li> or <option> the previous one, and a block element an open <p>; <script>
// and <style> are raw text; character references are decoded (named ones from HTML's list).
// The text is taken as UTF-8, as PHP's loadHTML was told to.

bool htmlIsVoid(StringView tag)
{
  for (StringView v : {"area", "base", "br", "col", "embed", "hr", "img", "input", "link", "meta", "param", "source", "track", "wbr"})
    if (tag == v)
      return true;
  return false;
}

// The elements whose start closes an open <p> (libxml2's list, the ones EGD uses among them).
bool htmlClosesParagraph(StringView tag)
{
  for (StringView v : {"p", "div", "table", "ul", "ol", "dl", "pre", "h1", "h2", "h3", "h4", "h5", "h6", "form", "hr",
                       "blockquote", "address", "center", "fieldset"})
    if (tag == v)
      return true;
  return false;
}

String htmlLower(StringView text)
{
  String out(text);
  for (ContainerSize i = 0; i < out.size(); ++i)
    if (out[i] >= 'A' && out[i] <= 'Z')
      out[i] = char(out[i] - 'A' + 'a');
  return out;
}

void htmlAppendCodePoint(String& out, u32 c)
{
  if (c == 0 || c > 0x10ffff || (c >= 0xd800 && c <= 0xdfff))
    c = 0xfffd;
  if (c < 0x80)
    out << char(c);
  else if (c < 0x800)
  {
    out << char(0xc0 | (c >> 6));
    out << char(0x80 | (c & 63));
  }
  else if (c < 0x10000)
  {
    out << char(0xe0 | (c >> 12));
    out << char(0x80 | ((c >> 6) & 63));
    out << char(0x80 | (c & 63));
  }
  else
  {
    out << char(0xf0 | (c >> 18));
    out << char(0x80 | ((c >> 12) & 63));
    out << char(0x80 | ((c >> 6) & 63));
    out << char(0x80 | (c & 63));
  }
}

// text with its character references decoded; an unknown one stays as written.
String htmlDecode(StringView text)
{
  String out;
  ContainerSize i = 0;
  while (i < text.size())
  {
    if (text[i] != '&')
    {
      out << text[i++];
      continue;
    }
    ContainerSize end = text.find(';', i);
    if (end == StringView::npos || end - i > 40)
    {
      out << text[i++];
      continue;
    }
    StringView name = text.substr(i + 1, end - i - 1);
    if (name.size() >= 2 && name[0] == '#')
    {
      bool hex = name[1] == 'x' || name[1] == 'X';
      u32 value = 0;
      bool ok = name.size() > (hex ? 2u : 1u);
      for (ContainerSize k = hex ? 2 : 1; k < name.size() && ok; ++k)
      {
        char c = name[k];
        i32 digit = c >= '0' && c <= '9' ? c - '0' : hex && c >= 'a' && c <= 'f' ? c - 'a' + 10 : hex && c >= 'A' && c <= 'F' ? c - 'A' + 10 : -1;
        if (digit < 0 || value > 0x10ffff)
          ok = false;
        else
          value = value * (hex ? 16 : 10) + (u32)digit;
      }
      if (ok)
      {
        htmlAppendCodePoint(out, value);
        i = end + 1;
        continue;
      }
    }
    else if (const char* named = markdown::markdownNamedEntity(name))
    {
      out << StringView(named);
      i = end + 1;
      continue;
    }
    out << text[i++];
  }
  return out;
}

bool htmlNameCharacter(char c) { return (c >= 'a' && c <= 'z') || (c >= 'A' && c <= 'Z') || (c >= '0' && c <= '9') || c == '-' || c == '_' || c == ':'; }

HtmlDocument readHtml(StringView html)
{
  HtmlBuilder builder;
  ContainerSize i = 0;
  ContainerSize textStart = 0;
  while (i < html.size())
  {
    if (html[i] != '<')
    {
      ++i;
      continue;
    }
    if (html.substr(i, 4) == "<!--")
    {
      builder.text(html.substr(textStart, i - textStart));
      ContainerSize end = html.find("-->", i + 4);
      i = end == StringView::npos ? html.size() : end + 3;
      textStart = i;
      continue;
    }
    if (i + 1 < html.size() && (html[i + 1] == '!' || html[i + 1] == '?'))
    {
      builder.text(html.substr(textStart, i - textStart));
      ContainerSize end = html.find('>', i);
      i = end == StringView::npos ? html.size() : end + 1;
      textStart = i;
      continue;
    }
    bool closing = i + 1 < html.size() && html[i + 1] == '/';
    ContainerSize nameStart = i + (closing ? 2 : 1);
    ContainerSize nameEnd = nameStart;
    while (nameEnd < html.size() && htmlNameCharacter(html[nameEnd]))
      ++nameEnd;
    if (nameEnd == nameStart)
    {
      ++i; // a '<' that starts no tag is text
      continue;
    }
    builder.text(html.substr(textStart, i - textStart));
    String tag = htmlLower(html.substr(nameStart, nameEnd - nameStart));
    // The attributes, to the '>' that is not inside a quoted value.
    Vector<Pair<String, String>> attributes;
    bool selfClosing = false;
    ContainerSize at = nameEnd;
    while (at < html.size() && html[at] != '>')
    {
      char c = html[at];
      if (c == ' ' || c == '\t' || c == '\r' || c == '\n')
      {
        ++at;
        continue;
      }
      if (c == '/')
      {
        selfClosing = at + 1 < html.size() && html[at + 1] == '>';
        ++at;
        continue;
      }
      ContainerSize attributeStart = at;
      while (at < html.size() && html[at] != '=' && html[at] != '>' && html[at] != ' ' && html[at] != '\t' &&
             html[at] != '\r' && html[at] != '\n' && !(html[at] == '/' && at + 1 < html.size() && html[at + 1] == '>'))
        ++at;
      String name = htmlLower(html.substr(attributeStart, at - attributeStart));
      String value;
      while (at < html.size() && (html[at] == ' ' || html[at] == '\t' || html[at] == '\r' || html[at] == '\n'))
        ++at;
      if (at < html.size() && html[at] == '=')
      {
        ++at;
        while (at < html.size() && (html[at] == ' ' || html[at] == '\t' || html[at] == '\r' || html[at] == '\n'))
          ++at;
        if (at < html.size() && (html[at] == '"' || html[at] == '\''))
        {
          char quote = html[at];
          ContainerSize close = html.find(quote, at + 1);
          if (close == StringView::npos)
            close = html.size();
          value = htmlDecode(html.substr(at + 1, close - at - 1));
          at = close + 1;
        }
        else
        {
          ContainerSize valueStart = at;
          while (at < html.size() && html[at] != '>' && html[at] != ' ' && html[at] != '\t' && html[at] != '\r' && html[at] != '\n')
            ++at;
          value = htmlDecode(html.substr(valueStart, at - valueStart));
        }
      }
      if (!name.empty() && !closing)
        attributes.push_back(Pair<String, String>(name, value));
    }
    i = at < html.size() ? at + 1 : html.size();
    textStart = i;
    if (closing)
    {
      builder.end(tag);
      continue;
    }
    builder.start(tag, move(attributes), selfClosing);
    if (tag == "script" || tag == "style")
    {
      // Its end tag in any case (EGD writes </SCRIPT> too).
      ContainerSize end = i;
      while (end < html.size() && !(html[end] == '<' && end + 1 < html.size() && html[end + 1] == '/' &&
                                    htmlLower(html.substr(end + 2, tag.size())) == tag))
        ++end;
      builder.text(html.substr(i, end - i));
      builder.end(tag);
      ContainerSize close = html.find('>', end);
      i = close == StringView::npos ? html.size() : close + 1;
      textStart = i;
    }
  }
  builder.text(html.substr(textStart, html.size() - textStart));
  return move(builder.document);
}
