// Who is logged in (src/auth.php). PHP kept a copy of the user's row in a server-side session; here
// the cookie gorating_id is signed instead, so nothing is stored on the server:
//   <user id>.<expiry, Unix seconds>.<HMAC-SHA256 of "<id>.<expiry>.<password hash>", hex>
// keyed by the configuration's sessionSecret. A changed password ends every session of that user,
// and the user's row is read on every request, so a page never shows a stale rating or setting.

constexpr i64 sessionSeconds = 3600 * 24 * 7; // a week, as PHP's
constexpr StringView sessionCookie = "gorating_id";

enum AdminLevel
{
  adminLevelOwner = 1,
  adminLevelAdmin = 2,
  adminLevelMod = 3,
  adminLevelTrustedUser = 4,
  adminLevelUser = 5,
  adminLevelUnregistered = 6,
};

i64 unixNow() { return durationCast<Seconds>(SystemClock::now().time_since_epoch()).count(); }

String sessionSignature(const GoratingConfig& config, StringView id, i64 expires, StringView passwordHash)
{
  return sha256::hmacSha256(config.sessionSecret, toString(id, ".", expires, ".", passwordHash)).hex();
}

String sessionCookieValue(const GoratingConfig& config, StringView id, i64 expires, StringView passwordHash)
{
  return toString(id, ".", expires, ".", sessionSignature(config, id, expires, passwordHash));
}

Optional<SessionCookie> parseSessionCookie(StringView value)
{
  ContainerSize dot1 = value.find('.');
  ContainerSize dot2 = dot1 == StringView::npos ? StringView::npos : value.find('.', dot1 + 1);
  if (dot2 == StringView::npos)
    return Optional<SessionCookie>();
  StringView id = value.substr(0, dot1);
  StringView expiresText = value.substr(dot1 + 1, dot2 - dot1 - 1);
  if (id.empty() || expiresText.empty() || id.size() > 10 || expiresText.size() > 12)
    return Optional<SessionCookie>();
  for (char c : id)
    if (c < '0' || c > '9')
      return Optional<SessionCookie>();
  for (char c : expiresText)
    if (c < '0' || c > '9')
      return Optional<SessionCookie>();
  return Optional<SessionCookie>(SessionCookie{String(id), stoll(String(expiresText)), String(value.substr(dot2 + 1))});
}

// Whether the cookie is a session of the user whose password hash this is, at the time now: not
// expired, and signed with the configuration's secret over that hash.
bool sessionValid(const GoratingConfig& config, const SessionCookie& cookie, StringView passwordHash, i64 now)
{
  if (cookie.expires < now)
    return false;
  return sha256::Sha256::constantTimeEqual(sessionSignature(config, cookie.id, cookie.expires, passwordHash), cookie.signature);
}

// The logged-in user's row, read into page; nothing when the cookie is missing, malformed, expired
// or signed with another secret or password.
void readSession(Page& page)
{
  Optional<String> value = page.request->cookie(sessionCookie);
  if (!value.has_value())
    return;
  Optional<SessionCookie> cookie = parseSessionCookie(*value);
  if (!cookie.has_value() || cookie->expires < unixNow())
    return;
  mariadb::MariaDbResult user = page.query("SELECT * FROM user WHERE id=", quote(cookie->id));
  if (user.empty() || !user.at(0, "password").has_value() || !sessionValid(*page.config, *cookie, *user.at(0, "password"), unixNow()))
    return;
  page.user = Optional<mariadb::MariaDbResult>(move(user));
}

bool loggedIn(const Page& page) { return page.user.has_value(); }

// The user's column (the row PHP kept in $_SESSION["user"]).
String userValue(const Page& page, StringView column)
{
  if (!page.user.has_value())
    return String();
  return Row(*page.user, 0)[column];
}

// PHP's adminLevel(): 1000 for a visitor, below every level.
i32 adminLevel(const Page& page) { return loggedIn(page) ? (i32)stoll(userValue(page, "admin_level_id")) : 1000; }
bool userCanDo(const Page& page, i32 level) { return adminLevel(page) <= level; }

bool canEditPlayerName(const Page& page) { return userCanDo(page, adminLevelMod); }
bool canSeeInviters(const Page& page) { return userCanDo(page, adminLevelMod); }
bool canSeeEmails(const Page& page) { return userCanDo(page, adminLevelMod); }
bool canInvite(const Page& page) { return userCanDo(page, adminLevelUser); }
bool canDeleteAnyGame(const Page& page) { return userCanDo(page, adminLevelAdmin); }
bool canAccessDeletedGames(const Page& page) { return userCanDo(page, adminLevelAdmin); }
bool canEditAnyGame(const Page& page) { return userCanDo(page, adminLevelAdmin); }
bool canAccessChanges(const Page& page) { return userCanDo(page, adminLevelAdmin); }
bool canReportWin(const Page& page) { return userCanDo(page, adminLevelTrustedUser); }
bool canShowStatistics(const Page& page) { return userCanDo(page, adminLevelOwner); }

constexpr StringView statisticsCookie = "gorating_statistics";

// The owner's switch for query statistics, kept in a cookie that counts for the owner only.
void toggleStatisticsAction(Page& page, http::HttpResponse& response)
{
  Form form(*page.request, "/");
  if (!canShowStatistics(page))
    form.fail("No rights");
  form.requirePost("Statistics are toggled with the button.");
  bool on = page.request->cookie(statisticsCookie).has_value();
  if (on)
    response.deleteCookie(statisticsCookie);
  else
  {
    http::HttpCookieOptions options;
    options.secure = page.config->secureCookies;
    response.setCookie(statisticsCookie, "1", options);
  }
  redirectWithMessage(response, "/", on ? StringView("Statistics turned OFF") : StringView("Statistics turned ON"));
}

// The rating's decimals the user chose (settings), 0 for a visitor.
i32 significantDigits(const Page& page)
{
  String digits = userValue(page, "setting_significant_digits_in_rating");
  return digits.empty() ? 0 : (i32)stoll(digits);
}

constexpr html::HtmlTemplate loginTemplate{R"(<form method="post" action="/login_action">
    <table>
      <tr>
        <td><label for="username">Username:</label></td>
        <td><input name="username" type="text"/></td>
      </tr>
      <tr>
        <td><label for="password">Password:</label></td>
        <td><input name="password" type="password"/></td>
      </tr>
    </table>
    <input type="submit" value="Login"/>
  </form>
  <a href="/reset_password">Reset password</a>
)"};
constexpr html::HtmlTemplate loggedInAsTemplate{R"(Currently logged in as {{username}}<form method="post" action="/logout"><input type="submit" value="Logoff"/></form>)"};

void loginPage(Page& page)
{
  if (loggedIn(page))
    page.body << loggedInAsTemplate.render({{"username", userValue(page, "username")}});
  else
    page.body << loginTemplate.render({});
}

// A redirect with ?message= (src/link_helper.php's redirectWithMessageCustom).
void redirectWithMessage(http::HttpResponse& response, StringView target, Text message)
{
  String location(target);
  location << (location.find('?') == String::npos ? StringView("?") : StringView("&"));
  location << "message=" << url::urlEncode(toString(message));
  response.redirect(location);
}

void loginAction(Page& page, http::HttpResponse& response)
{
  if (page.request->method != "POST")
  {
    response.redirect("/login");
    return;
  }
  Form form(*page.request, "/login");
  String username = form.text("username");
  String password = form.text("password");
  if (username.empty())
    form.fail("username not provided");
  if (password.empty())
    form.fail("password not provided");
  mariadb::MariaDbResult user = page.query("SELECT id, username, password FROM user WHERE username=", quote(username));
  // One message for both, so the form does not tell which usernames exist (PHP said "not found").
  if (user.empty() || !user.at(0, "password").has_value() || !bcrypt::bcryptVerify(password, *user.at(0, "password")))
    form.fail("Wrong username or password!");
  Row row(user, 0);
  i64 expires = unixNow() + sessionSeconds;
  http::HttpCookieOptions options;
  options.maxAgeSeconds = Optional<i64>(sessionSeconds);
  options.secure = page.config->secureCookies;
  response.setCookie(sessionCookie, sessionCookieValue(*page.config, row["id"], expires, row["password"]), options);
  response.redirect(playerPath(row["id"], row["username"]));
}

void logoutAction(Page&, http::HttpResponse& response)
{
  response.deleteCookie(sessionCookie);
  response.redirect("/");
}
