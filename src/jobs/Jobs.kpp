// The background jobs (update_tournament_list.php, check_new_tournaments.php, process_tournament.php,
// process_tournament_batch.php, update_rating.php): the cron calls update_tournament_list hourly.
// PHP's job addresses were open to anyone; here they run from the server's shell (`gorating.cgi
// --job NAME`, the cron's command: kovarex, 2026-11-05, "the whole job secret would be eradicated")
// or for the logged-in owner, nobody else. They answer in plain text.

constexpr i32 tournamentsPerBatch = 30;

// A job run from the command line (main's --job): whoever runs it is on the server already.
bool jobFromCommandLine = false;

bool mayRunJobs(const Page& page)
{
  return jobFromCommandLine || canShowStatistics(page);
}

// The tournaments already stored or queued (getTournamentsToIgnore).
bool tournamentKnown(Page& page, StringView key)
{
  return !page.query(String("SELECT egd_key FROM egd_tournament WHERE egd_key=") + quote(key) +
                     " UNION SELECT egd_key FROM egd_tournament_to_process WHERE egd_key=" + quote(key)).empty();
}

// Queues keys, the last one first (EGD lists the newest first), skipping the known ones; how many.
i32 queueTournaments(Page& page, const Vector<String>& keys)
{
  i32 queued = 0;
  for (ContainerSize i = keys.size(); i > 0; --i)
  {
    const String& key = keys[i - 1];
    if (!isTournamentKey(key) || tournamentKnown(page, key))
      continue;
    page.query(String("INSERT INTO egd_tournament_to_process(egd_key) VALUES(") + quote(key) + ")");
    ++queued;
  }
  return queued;
}

// Up to tournamentsPerBatch queued tournaments, half a second apart when EGD is asked (as PHP).
String processTournamentBatch(Page& page)
{
  String out;
  i32 done = 0;
  for (i32 i = 0; i < tournamentsPerBatch; ++i)
  {
    if (!processTournament(page, String()))
      break;
    ++done;
    if (page.config->egdPageDirectory.empty())
      thisThread::sleepFor(Milliseconds(500));
  }
  String remaining = page.db->scalar("SELECT COUNT(*) FROM egd_tournament_to_process").value_or(String("0"));
  out << format("Processed {} tournaments, {} remaining.\n", done, remaining);
  return out;
}

// EGD's whole tournament list (downloads/tlist.html): its lines " T261031D  A  5 ..." with a key in
// columns 2 to 10.
Vector<String> tournamentListKeys(StringView list)
{
  Vector<String> keys;
  ContainerSize at = 0;
  while (at < list.size())
  {
    ContainerSize end = at;
    while (end < list.size() && list[end] != '\r' && list[end] != '\n')
      ++end;
    StringView line = list.substr(at, end - at);
    if (line.size() >= 11 && line[0] == ' ' && line[10] == ' ')
    {
      StringView key = line.substr(0, 11);
      while (!key.empty() && key[0] == ' ')
        key = key.substr(1);
      while (!key.empty() && key[key.size() - 1] == ' ')
        key = key.substr(0, key.size() - 1);
      keys.push_back(String(key));
    }
    at = end + 1;
  }
  return keys;
}

// EGD's tournament search, newest first, as PHP posted it (getPageOfLatestTournaments).
constexpr StringView latestTournamentsForm = "ricerca=1&orderBy=orderBy%3DTournament_Date%2CTournament_Code&viewStart=viewStart%3D0"
                                             "&orderDir=orderDir%3DDESC&tournament_code=&date_from=&date_to=&tournament_description="
                                             "&country_code=%2A&city=%2A&filter=All";

Vector<String> latestTournamentKeys(Page& page)
{
  return readEgdTournamentSearch(readHtml(fetchEgd(*page.config, String(egdAddress) + "Find_Tournament.php", latestTournamentsForm)));
}

// The jobs' addresses; false for any other.
bool runJob(Page& page, StringView name, http::HttpResponse& response)
{
  bool job = name == "update_tournament_list" || name == "check_new_tournaments" || name == "process_tournament" ||
             name == "process_tournament_batch" || name == "update_rating" || name == "check_rating_changes" ||
             name == "collect_manual_rating_changes";
  if (!job)
    return false;
  response.setHeader("Content-Type", "text/plain; charset=utf-8");
  if (!mayRunJobs(page))
  {
    response.status = 403;
    response.body = "The jobs run from the server's shell (gorating.cgi --job NAME), or for the owner.\n";
    return true;
  }
  if (name == "update_tournament_list")
  {
    i32 queued = queueTournaments(page, tournamentListKeys(fetchEgd(*page.config, String(egdAddress) + "EGD_2_0/downloads/tlist.html")));
    response.body = format("Queued {} tournaments.\n", queued) + processTournamentBatch(page);
    // The cron calls only this job: it also moves a rating update on, for up to ratingUpdateSeconds
    // (PHP's moved only when a game was deleted or edited, or update_rating called).
    response.body << processRating(page, ratingUpdateSeconds) + "\n";
  }
  else if (name == "check_new_tournaments")
  {
    i32 queued = queueTournaments(page, latestTournamentKeys(page));
    response.body = format("Added {} to be processed.\n", queued) + processTournamentBatch(page);
  }
  else if (name == "process_tournament")
  {
    String key = page.get("egd_tournament_key");
    response.body = processTournament(page, key) ? String("Processed.\n") : String("No tournament to process.\n");
  }
  else if (name == "process_tournament_batch")
    response.body = processTournamentBatch(page);
  else if (name == "check_rating_changes")
    response.body = checkRatingChanges(page);
  else if (name == "collect_manual_rating_changes")
    response.body = collectManualRatingChanges(page);
  else
    response.body = processRating(page, ratingUpdateSeconds) + "\n";
  return true;
}

// `gorating.cgi --job NAME [PARAMETER=VALUE...]`: the job NAME run as its address would run it (the
// parameters its query's), its answer in output; 0 when it answered 200, 1 when it failed (what
// went wrong in output), 2 for no such job. The cron's command (with --quiet: main prints nothing
// when it worked, so the cron mails only failures).
i32 jobCommand(const Vector<String>& arguments, String& output)
{
  const char* usage = "usage: gorating.cgi --job NAME [--quiet] [PARAMETER=VALUE...] (update_tournament_list, check_new_tournaments,"
                      " process_tournament, process_tournament_batch, update_rating, check_rating_changes, collect_manual_rating_changes)\n";
  if (arguments.empty())
  {
    output = usage;
    return 2;
  }
  String target = String("/") + arguments[0];
  for (ContainerSize i = 1; i < arguments.size(); ++i)
    target << String(i == 1 ? "?" : "&") + arguments[i];
  http::HttpRequest request;
  request.method = "GET";
  http::httpSetTarget(request, target);
  request.remoteAddress = "command line";
  http::HttpResponse response;
  jobFromCommandLine = true;
  try
  {
    handle(request, response);
  }
  catch (const Exception& e)
  {
    jobFromCommandLine = false;
    output = format("{} failed: {}\n", arguments[0], StringView(e.what()));
    return 1;
  }
  jobFromCommandLine = false;
  if (response.header("Content-Type") == nullptr || *response.header("Content-Type") != "text/plain; charset=utf-8" ||
      response.status == 404 || response.status == 501)
  {
    output = String("no job ") + arguments[0] + "\n" + usage;
    return 2;
  }
  output = response.body;
  return response.status == 200 ? 0 : 1;
}
