// The European Go Database's pages (src/egd_api.php): fetching them, and a player's card into the
// database (EgdPages.kpp reads the pages).
//
// fetchEgd takes a page from the configuration's egdPageDirectory when it names one (saved pages,
// named by egdPageName: the comparisons with PHP read the same files); else through scrape.do when
// the configuration has its token (scrapeDoToken), as PHP's scrape() did; else from EGD itself.

// A saved page's file name: the SHA-256 of the address and the form (empty for a GET), in hex.
String egdPageName(StringView url, StringView form)
{
  return sha256::sha256(String(url) + "\n" + String(form)).hex() + ".html";
}

// The address scrape.do fetches url through. Over HTTPS: PHP asked http://api.scrape.do, which sent
// the token in clear.
String scrapeDoAddress(StringView token, StringView url)
{
  return toString("https://api.scrape.do/?url=", url::urlEncode(url), "&token=", url::urlEncode(token));
}

String fetchEgd(const GoratingConfig& config, StringView url, StringView form = "")
{
  if (!config.egdPageDirectory.empty())
    return goratingReadFile(config.egdPageDirectory + "/" + egdPageName(url, form));
  String address = config.scrapeDoToken.empty() ? String(url) : scrapeDoAddress(config.scrapeDoToken, url);
  httpclient::HttpClientRequest request;
  request.url = address;
  request.timeoutMilliseconds = 120000; // scrape.do waits for the page it fetches
  if (!form.empty())
  {
    // scrape.do sends a POST's body on to the page, as PHP's getUrlContent posted it.
    request.method = "POST";
    request.headers.push_back(httpclient::HttpClientHeader{String("Content-Type"), String("application/x-www-form-urlencoded")});
    request.body = String(form);
  }
  httpclient::HttpClientResponse page = httpclient::fetch(request);
  if (page.status != 200)
    throw GoratingError(toString(StringView(config.scrapeDoToken.empty() ? "EGD" : "scrape.do"), " answered ", page.status, " for ", url));
  return page.body;
}

// A number as PHP keeps it: the text it was read as (a page's, the database's), or a double it
// computed. Written into SQL as PHP wrote it: the text as it is, a double with 14 digits.
struct PhpNumber
{
  bool computed = false;
  String text;
  double value = 0;

  PhpNumber() {}
  static PhpNumber read(StringView text)
  {
    PhpNumber n;
    n.text = String(text);
    n.value = text.empty() ? 0.0 : stod(String(text));
    return n;
  }
  static PhpNumber of(double value)
  {
    PhpNumber n;
    n.computed = true;
    n.value = value;
    return n;
  }
  String sql() const { return this->computed ? phpNumber(this->value) : this->text; }
  PhpNumber operator+(const PhpNumber& other) const { return PhpNumber::of(this->value + other.value); }
};

// PHP's is_numeric for what EGD's pages hold: an optional sign, digits, a point, an exponent.
bool phpIsNumeric(StringView text)
{
  return number(text).has_value();
}

// PHP 8's loose == of two column values: as numbers when both are numeric, else as text; NULL
// equals "" only.
bool phpLooseEqual(const Optional<String>& a, const Optional<String>& b)
{
  if (!a.has_value() || !b.has_value())
    return (a.has_value() ? a->empty() : true) && (b.has_value() ? b->empty() : true);
  if (phpIsNumeric(*a) && phpIsNumeric(*b))
    return *number(*a) == *number(*b);
  return *a == *b;
}

struct EgdCountry
{
  String id;
  String code;
};

// "Germany (DE)": the code in the last brackets, and its country (getCountryCodeAndID).
EgdCountry egdCountry(Page& page, StringView country)
{
  ContainerSize space = country.rfind(' ');
  StringView last = space == StringView::npos ? country : country.substr(space + 1);
  String code = last.size() >= 2 ? String(last.substr(1, last.size() - 2)) : String();
  mariadb::MariaDbResult found = page.query("SELECT id FROM country WHERE code=", quote(code));
  if (found.empty())
    throw GoratingError(toString("Couldn't find country with code:", code, " complete name:", country));
  return EgdCountry{Row(found, 0)["id"], code};
}

// A tournament's class, "A (1x)", as its game type (getGameTypeID).
i32 egdGameType(StringView text)
{
  if (text.starts_with("A"))
    return gameTypeEgdA;
  if (text.starts_with("B"))
    return gameTypeEgdB;
  if (text.starts_with("C"))
    return gameTypeEgdC;
  if (text.starts_with("D"))
    return gameTypeEgdD;
  throw GoratingError(toString("Couldn't determine egd tournament class from the string:", text));
}

// T, W, E or G and 3 to 9 more characters (isTournamentKey).
bool isTournamentKey(StringView key)
{
  return key.size() >= 4 && key.size() <= 10 && (key[0] == 'T' || key[0] == 'W' || key[0] == 'E' || key[0] == 'G');
}

constexpr StringView egdAddress = "https://www.europeangodatabase.eu/EGD/";

struct EgdPlayerInfo
{
  String rating;
  EgdCountry country;
};

// A player's rating and country from their EGD card (getEgdInfo).
EgdPlayerInfo egdPlayerInfo(Page& page, StringView pin)
{
  String url = String(egdAddress) + "Player_Card.php?&key=" + String(pin);
  EgdPlayerCard card = readEgdPlayerCard(readHtml(fetchEgd(*page.config, url)), url);
  return EgdPlayerInfo{card.rating, egdCountry(page, card.country)};
}

// The user with this EGD pin, made from their card when there is none yet (addEGDPlayerIfNotPresent).
String addEgdPlayerIfNotPresent(Page& page, StringView pin, StringView firstName, StringView lastName)
{
  mariadb::MariaDbResult found = page.query("SELECT id FROM user WHERE egd_pin =", quote(pin));
  if (!found.empty())
    return Row(found, 0)["id"];
  EgdPlayerInfo info = egdPlayerInfo(page, pin);
  page.query("INSERT INTO user(first_name, last_name, egd_pin, egd_rating, rating, country_id, admin_level_id) VALUES(",
             quoteOrNull(firstName), ",", quoteOrNull(lastName), ",", quote(pin), ",", quote(info.rating), ",",
             quote(info.rating), ",", quote(info.country.id), ",6)");
  return *page.db->scalar("SELECT LAST_INSERT_ID()");
}
