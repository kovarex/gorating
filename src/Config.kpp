// The site's configuration: a JSON file that is never committed (it has the database's password),
// named by GORATING_CONFIG, else gorating-config.json in the working directory. Its form:
//   {"database": {"host": "127.0.0.1", "port": 3306, "user": "...", "password": "...", "name": "..."},
//    "resourceAddress": "https://...", "sessionSecret": "<32+ random characters>", "secureCookies": true}
// resourceAddress is where the bundled CSS and JS (assets/build.sh) and img/ are; "" is the site's
// own root (Apache serves them there; a local run serves them from staticDirectory).

struct GoratingConfig
{
  mariadb::MariaDbOptions database;
  String resourceAddress;
  String staticDirectory; // with resourceAddress "": where the files are (this checkout)
  String sessionSecret;   // signs the session cookie (Session.kpp): 32 or more random characters
  bool secureCookies = false; // true when the site is HTTPS: cookies are never sent in clear
  String siteAddress;         // "https://gorating.com" for links in mails; "": from the request's Host
  String mailCommand;         // reads a whole message on its input: "/usr/sbin/sendmail -t -i"
  String mailDirectory;       // or: a directory each message is written to as a file
  String egdPageDirectory;    // saved EGD pages instead of EGD (Egd.kpp), for comparisons
  String scrapeDoToken;       // EGD's pages through scrape.do (Egd.kpp); "": from EGD itself
};

class GoratingError : public RuntimeError
{
public:
  GoratingError() {}
  GoratingError(const String& message) : RuntimeError(message) {}
};

String goratingReadFile(const String& path)
{
  FILE* file = fopen(path.c_str(), "rb");
  if (!file)
    throw GoratingError(toString("cannot read ", path));
  String text;
  char buffer[65536];
  for (;;)
  {
    usize n = fread(buffer, 1, 65536, file);
    if (n == 0)
      break;
    text << StringView(buffer, (ContainerSize)n);
  }
  fclose(file);
  return text;
}

GoratingConfig goratingReadConfig()
{
  const char* named = getenv("GORATING_CONFIG");
  String path = named != nullptr ? String(StringView(named)) : String("gorating-config.json");
  json::JsonValue root = json::parseJson(goratingReadFile(path));
  GoratingConfig config;
  const json::JsonValue& database = root["database"];
  config.database.host = database["host"].asString();
  config.database.port = (i32)database["port"].asInteger();
  config.database.user = database["user"].asString();
  config.database.password = database["password"].asString();
  config.database.database = database["name"].asString();
  config.resourceAddress = root["resourceAddress"].asString();
  if (const json::JsonValue* directory = root.find("staticDirectory"))
    config.staticDirectory = directory->asString();
  config.sessionSecret = root["sessionSecret"].asString();
  if (config.sessionSecret.size() < 32)
    throw GoratingError(toString(path, ": sessionSecret has ", (i64)config.sessionSecret.size(), " characters; it needs 32 or more"));
  if (const json::JsonValue* secure = root.find("secureCookies"))
    config.secureCookies = secure->asBool();
  for (auto [name, field] : {Pair<const char*, String*>{"siteAddress", &config.siteAddress},
                             Pair<const char*, String*>{"mailCommand", &config.mailCommand},
                             Pair<const char*, String*>{"mailDirectory", &config.mailDirectory},
                             Pair<const char*, String*>{"egdPageDirectory", &config.egdPageDirectory},
                             Pair<const char*, String*>{"scrapeDoToken", &config.scrapeDoToken}})
    if (const json::JsonValue* value = root.find(name))
      *field = value->asString();
  return config;
}
