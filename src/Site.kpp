// The links every page makes and how pages show ratings, ranks and dates (src/link_helper.php and
// src/rating_helper.php in the PHP version). A request's context is a Page, a row a Row.

String quote(StringView text) { return mariadb::mariaDbQuote(text); }

// The pages a username cannot name (start.php's list): /login is the login page, not a player.
bool isPageName(StringView name)
{
  for (StringView page : {"login_action", "logout", "register_action", "report_action", "edit_player_name_action",
                          "delete_game_action", "restore_game_action", "sgf", "process_tournament", "update_rating",
                          "process_tournament_batch", "invite_action", "invite_existing_user_action", "edit_game_action",
                          "check_new_tournaments", "get_new_tournaments_contents", "scrap", "reset_password_action",
                          "reset_password_confirm_action", "toggle_statistics", "collect_manual_rating_changes",
                          "settings_action", "update_tournament_list", "check_rating_changes", "login", "player",
                          "players", "invites", "tournaments", "tournament", "register", "report", "about",
                          "get_all_egd_players", "deleted_games", "invite_existing_user", "edit_game", "reset_password",
                          "reset_password_confirm", "settings", "changes", "game", "rating_discrepancies"})
    if (name == page)
      return true;
  return false;
}

// A player's page: /username, or /player?id= for one without a username or with a page's name.
// (The PHP version meant to check the page names but checked an undefined variable.)
String playerPath(StringView id, StringView username)
{
  if (!username.empty() && !isPageName(username))
    return toString("/", username);
  return toString("/player?id=", id);
}

// --- ranks (src/rating_helper.php) ---

// 30k is rank 1, 1k rank 30, 1D rank 31: rating 2050 to 2150 is 1D.
i32 rankFromRating(double rating)
{
  double rank = (rating + 1050) / 100;
  return (i32)floor(rank < 1 ? 1 : rank);
}

String readableRank(i32 rank)
{
  if (rank <= 30)
    return toString(31 - rank, "k");
  return toString(rank - 30, "D");
}

double ratingValue(StringView text) { return text.empty() ? 0.0 : stod(String(text)); }

// The player whose columns start with prefix ("black" reads black_id, black_name...).
PlayerRef playerRef(const Row& row, StringView prefix)
{
  String p = prefix.empty() ? String() : String(prefix) + "_";
  PlayerRef player;
  player.id = row[p + "id"];
  player.name = row[p + "name"];
  player.username = row[p + "username"];
  if (row.has(p + "rating") && !row.isNull(p + "rating"))
    player.rating = Optional<String>(row[p + "rating"]);
  if (row.has(p + "egd_rating") && !row.isNull(p + "egd_rating"))
    player.egdRating = Optional<String>(row[p + "egd_rating"]);
  return player;
}

// "Name 5k".
String playerNameWithRank(const PlayerRef& player)
{
  String rating = player.rating.has_value() ? *player.rating : player.egdRating.has_value() ? *player.egdRating : String();
  return player.name + " " + readableRank(rankFromRating(ratingValue(rating)));
}

constexpr html::HtmlTemplate linkTemplate{R"(<a href="{{href}}">{{text}}</a>)"};

html::SafeHtml link(StringView href, StringView text)
{
  return linkTemplate.render({{"href", String(href)}, {"text", String(text)}});
}

html::SafeHtml playerLink(const PlayerRef& player)
{
  if (player.id.empty())
    return html::SafeHtml();
  return link(playerPath(player.id, player.username), playerNameWithRank(player));
}

html::SafeHtml playerLink(const Row& row, StringView prefix) { return playerLink(playerRef(row, prefix)); }

constexpr html::HtmlTemplate egdLinkTemplate{R"(<a href="https://www.europeangodatabase.eu/EGD/Player_Card.php?&amp;key={{pin}}">{{pin}}</a>)"};
constexpr html::HtmlTemplate egdTournamentLinkTemplate{R"(<a href="https://www.europeangodatabase.eu/EGD/Tournament_Card.php?&amp;key={{key}}">{{key}}</a>)"};

html::SafeHtml egdLink(StringView pin)
{
  if (pin.empty())
    return html::SafeHtml();
  return egdLinkTemplate.render({{"pin", String(pin)}});
}

html::SafeHtml egdTournamentLink(StringView key) { return egdTournamentLinkTemplate.render({{"key", String(key)}}); }

constexpr html::HtmlTemplate sgfLinkTemplate{R"(<a href="/sgf?id={{id}}">SGF</a>)"};

html::SafeHtml sgfLink(StringView gameId) { return sgfLinkTemplate.render({{"id", String(gameId)}}); }

// The viewer's decimals for ratings (their setting; 0 for a visitor), set for each request.
i32 ratingDigits = 0;

// A rating with the viewer's decimals, as %.Nf rounds.
String showRating(StringView rating) { return toString(fixed(ratingValue(rating), ratingDigits)); }

html::SafeHtml tournamentLink(StringView id, StringView name)
{
  return link(toString("/tournament?id=", id), name.empty() ? StringView("[no name]") : name);
}

constexpr html::HtmlTemplate resultImageTemplate{R"(<img class="result-image" src="{{resources}}/img/{{result}}.png"/>)"};

// WIN, LOSS or JIGO as its picture.
html::SafeHtml resultImage(const Page& page, StringView result)
{
  String lower;
  for (char c : result)
    lower << (c >= 'A' && c <= 'Z' ? char(c - 'A' + 'a') : c);
  return resultImageTemplate.render({{"resources", page.config->resourceAddress}, {"result", lower}});
}

// "Even", "komi 0.5", "3h" or "3h komi 5.5", from the database's text of each.
String showHandicap(StringView handicap, StringView komi)
{
  double k = ratingValue(komi);
  if (handicap == "0" && (k == 6.5 || k == 7.5))
    return "Even";
  if (handicap == "0")
    return toString("komi ", komi);
  return String(handicap) + "h" + (k == 0.5 ? String(" ") : toString(" komi ", komi));
}

// "2026-11-02 13:45:07" as "02. 11. 2026 13:45" (withTime) or "02. 11. 2026".
String showDate(StringView timestamp, bool withTime)
{
  if (timestamp.size() < 16)
    return String(timestamp);
  String out = String(timestamp.substr(8, 2)) + ". " + String(timestamp.substr(5, 2)) + ". " + String(timestamp.substr(0, 4));
  if (withTime)
    out << " " << String(timestamp.substr(11, 5));
  return out;
}
