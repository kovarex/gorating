// Deleting and restoring a game (delete_game_action.php, restore_game_action.php), for admins: the
// game's deleted flag, then the rating update the database's trigger starts. PHP did both on a GET
// link, which another site could make an admin's browser follow; here they take a POST from a form.

// A redirect target from a form: a path on this site only (PHP sent the browser to any address).
String localRedirect(StringView target, StringView fallback)
{
  if (target.size() >= 1 && target[0] == '/' && !(target.size() >= 2 && (target[1] == '/' || target[1] == '\\')))
    return String(target);
  return String(fallback);
}

void setGameDeleted(Page& page, http::HttpResponse& response, bool deleted)
{
  Form form(*page.request, "/");
  if (!canDeleteAnyGame(page))
    form.fail(deleted ? StringView("No rights to delete this game.") : StringView("No rights to restore this game."));
  form.requirePost("A game is deleted and restored with a form.");
  String redirect = localRedirect(form.text("redirect"), "/");
  form.setTarget(redirect);
  String idText = form.text("id");
  if (idText.empty())
    form.fail("Game id not specified");
  u64 id = form.number<u64>("id", "Game id is not numeric:", idText);
  page.query("UPDATE game SET deleted=", deleted, " WHERE id=", id);
  redirectWithMessage(response, redirect, "Game with id=", id, deleted ? StringView(" deleted.\n") : StringView(" restored.\n"),
                      processRating(page, ratingUpdateSeconds));
}

void deleteGameAction(Page& page, http::HttpResponse& response) { setGameDeleted(page, response, true); }
void restoreGameAction(Page& page, http::HttpResponse& response) { setGameDeleted(page, response, false); }
