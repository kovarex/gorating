        <table>
          <tr><td>First name:</td><td>{{first}}</td></tr>
          <tr><td>Last name:</td><td>{{last}}</td></tr>
          <tr><td>EGD pin:</td><td>{{pin}}</td></tr>
          <tr><td>Rating</td><td>{{rating}}</td></tr>
          <tr>
            <td><label for="email">email:</label></td>
            <td><input type="text" name="email"/></td>
          </tr>
        </table>
        <input type="hidden" name="user_id" value="{{id}}"/>
        <input type="hidden" name="redirect" value="/invites"/>
        <input type="submit" value="invite"/>
      </form>)"};

void inviteExistingUserPage(Page& page)
{
  if (!requireLogin(page))
    return;
  String id = page.get("user_id");
  mariadb::MariaDbResult found = page.query("SELECT * FROM user WHERE id=", quote(id));
  if (id.empty() || found.empty())
  {
    page.body << pageMessageTemplate.render({{"message", toString("User with id=", id, " not found")}});
    return;
  }
  Row player(found, 0);
  page.body << inviteExistingTemplate.render({{"first", player["first_name"]},
                                                  {"last", player["last_name"]},
                                                  {"pin", egdLink(player["egd_pin"])},
                                                  {"rating", player["rating"]},
                                                  {"id", player["id"]}});
}

void inviteExistingUserAction(Page& page, http::HttpResponse& response)
{
  Form form(*page.request, "/");
  if (!loggedIn(page) || !canInvite(page))
    form.fail("Not logged in");
  form.setTarget("/invites");
  form.requirePost("An invite is made with the form.");
  String userId = form.text("user_id");
  String email = form.text("email");
  if (userId.empty())
    form.fail("user_id of player to register not provided");
  mariadb::MariaDbResult found = page.query("SELECT * FROM user WHERE user.id=", quote(userId));
  if (found.empty())
    form.fail("User with id=", userId, " not found.");
  Row user(found, 0);
  if (!user["username"].empty())
    form.fail(user["name"] + " is already registered.");
  if (email.empty())
    form.fail("Email not provided");
  if (!isMailAddress(email))
    form.fail("That is not an email address");
  if (!page.query("SELECT id FROM user WHERE email=", quote(email)).empty())
    form.fail("Player with this email is already registered");
  String secret = secureRandomSecret();
  page.query("INSERT INTO invite(from_user_id, user_id, email, secret) VALUES (", quote(userValue(page, "id")), ",",
             quote(userId), ",", quote(email), ",", quote(secret), ")");
  String id = *page.db->scalar("SELECT LAST_INSERT_ID()");
  sendMail(*page.config, email, "Friendly go rating invitation",
           inviteExistingMailTemplate.render({{"player", siteAddress(page) + playerPath(user["id"], user["username"])},
                                              {"name", playerNameWithRank(playerRef(user, ""))},
                                              {"link", inviteAddress(page, id, secret)}}));
  redirectWithMessage(response, "/invites", "Invite created");
}

// --- registration ---

// The invite of id when secret is its secret and no one registered with it yet; else the reason.
Optional<String> registrationProblem(Page& page, StringView id, StringView secret)
{
  if (id.empty())
    return Optional<String>(String("Invite ID not specified."));
  mariadb::MariaDbResult invite = page.query("SELECT * FROM invite WHERE id=", quote(id));
  if (invite.empty())
    return Optional<String>(toString("Specified invite with id=", id, " doesn't exist."));
  Row row(invite, 0);
  if (!sha256::Sha256::constantTimeEqual(row["secret"], secret))
    return Optional<String>(String("Secret incorrect"));
  if (!page.query("SELECT id FROM user WHERE email=", quote(row["email"])).empty())
    return Optional<String>(String("User with this email already present."));
  return Optional<String>();
}

constexpr html::HtmlTemplate registerTemplate{R"(<div>You can now finish your registration with the following details</div><br/><form method="post" action="/register_action">
       <table>
         <tr><td>First name:</td><td>{{first}}</td></tr>
         <tr><td>Last name:</td><td>{{last}}</td></tr>
         <tr><td>email:</td><td>{{email}}</td></tr>
         {{who}}
         <tr>
           <td><label for="username">Username:</label></td>
           <td><input name="username" type="text"/></td>
         </tr>
         <tr>
           <td><label for="password">Password:</label></td>
           <td><input name="password" type="password"/></td>
         </tr>
       </table>
       <input type="hidden" name="invite_id" value="{{id}}"/>
       <input type="hidden" name="secret" value="{{secret}}"/>
       <input type="submit" value="Register"/>
     </form>)"};
constexpr html::HtmlTemplate existingUserRowTemplate{R"(<tr><td>Existing user:</td><td>{{link}}</td></tr>)"};
constexpr html::HtmlTemplate countryRowTemplate{R"(<tr><td>Country:</td><td>{{selector}}</td></tr>)"};

void registerPage(Page& page)
{
  String id = page.get("id");
  String secret = page.get("secret");
  Optional<String> problem = registrationProblem(page, id, secret);
  if (problem.has_value())
  {
    page.body << pageMessageTemplate.render({{"message", *problem}});
    return;
  }
  mariadb::MariaDbResult invited = page.query("SELECT * FROM invite WHERE id=", quote(id));
  Row row(invited, 0);
  mariadb::MariaDbResult user;
  if (!row["user_id"].empty())
    user = page.query("SELECT * FROM user WHERE id=", quote(row["user_id"]));
  bool existing = !user.empty();
  Row existingUser = existing ? Row(user, 0) : Row();
  page.body << registerTemplate.render(
      {{"first", existing ? existingUser["first_name"] : row["first_name"]},
       {"last", existing ? existingUser["last_name"] : row["last_name"]},
       {"email", row["email"]},
       {"who", existing ? existingUserRowTemplate.render({{"link", playerLink(existingUser, "")}})
                        : countryRowTemplate.render({{"selector", countrySelector(page, "")}})},
       {"id", id},
       {"secret", secret}});
}

// A bcrypt hash as PHP's password_hash writes it (cost 10).
String passwordHash(StringView password) { return bcrypt::bcryptHash(password, 10, secureRandomBytes(16)); }

// A username: 1 to 64 letters, digits, '_', '-' and '.', and no page's name (PHP took anything).
bool isUsername(StringView name)
{
  if (name.empty() || name.size() > 64 || isPageName(name))
    return false;
  for (char c : name)
    if (!((c >= 'a' && c <= 'z') || (c >= 'A' && c <= 'Z') || (c >= '0' && c <= '9') || c == '_' || c == '-' || c == '.'))
      return false;
  return true;
}

void registerAction(Page& page, http::HttpResponse& response)
{
  Form form(*page.request, "/");
  form.requirePost("Registration is done with the form.");
  String id = form.text("invite_id");
  String secret = form.text("secret");
  String back = toString("/register?id=", url::urlEncode(id), "&secret=", url::urlEncode(secret));
  Optional<String> problem = registrationProblem(page, id, secret);
  if (problem.has_value())
    form.fail(*problem);
  mariadb::MariaDbResult invited = page.query("SELECT * FROM invite WHERE id=", quote(id));
  Row row(invited, 0);
  String username = form.text("username");
  String password = form.text("password");
  form.setTarget(back);
  if (!isUsername(username))
    form.fail("A username is letters, digits, '_', '-' and '.', and not a page's name");
  if (password.size() < 4)
    form.fail("The password needs 4 characters or more");
  if (!page.query("SELECT id FROM user where username=", quote(username)).empty())
    form.fail("The username \"", username, "\" is taken");
  String hash = passwordHash(password);
  String newUserId;
  page.db->begin();
  if (!row["user_id"].empty())
  {
    if (page.query("SELECT id FROM user WHERE id=", quote(row["user_id"])).empty())
    {
      page.db->rollback();
      form.fail("The user you are supposed to register as doesn't exist.");
    }
    page.query("UPDATE user SET username=", quote(username), ", email=", quote(row["email"]), ", password=", quote(hash),
               ", admin_level_id=5, invited_by_user_id=", row["from_user_id"],
               ", register_timestamp=now(), register_rating=user.rating WHERE user.id=", quote(row["user_id"]));
    newUserId = row["user_id"];
  }
  else
  {
    String country = form.text("country_code");
    if (country.empty())
    {
      page.db->rollback();
      form.fail("Country not selected");
    }
    mariadb::MariaDbResult countries = page.query("SELECT id FROM country WHERE code=", quote(country));
    if (countries.empty())
    {
      page.db->rollback();
      form.fail("Country with code '", country, "' not found.");
    }
    String rating = row["rating"].empty() ? String("100") : row["rating"];
    page.query("INSERT INTO user(username, first_name, last_name, email, rating, register_rating, password, country_id,"
               " admin_level_id, invited_by_user_id, register_timestamp) VALUES(",
               quote(username), ",", quote(row["first_name"]), ",", quote(row["last_name"]), ",", quote(row["email"]), ",",
               quote(rating), ",", quote(rating), ",", quote(hash), ",", quote(Row(countries, 0)["id"]), ",5,",
               row["from_user_id"], ", now())");
    newUserId = *page.db->scalar("SELECT LAST_INSERT_ID()");
  }
  page.query("DELETE FROM invite WHERE user_id=", quote(newUserId));
  page.db->commit();
  redirectWithMessage(response, playerPath(newUserId, username), "Registration successful.");
}

// --- password resets ---

constexpr html::HtmlTemplate resetPasswordTemplate{R"(<div>Enter the email address of your account so we can send you a link to reset your password.</div>
<form method="post" action="/reset_password_action">
  <table>
    <tr><td><label for="email">email:</label></td><td><input type="text" id="email" name="email"/></td></tr>
  </table>
  <input type="submit" value="Send reset link"/>
</form>
)"};
constexpr html::HtmlTemplate resetMailTemplate{R"(You have requested to reset your password<br/>
Follow this <a href="{{link}}">link</a> to proceed.<br/>
If you didn't order the reset, you can ignore the email.)"};
constexpr html::HtmlTemplate resetConfirmTemplate{R"(Now you can set a new password:<br/>
<form method="post" action="/reset_password_confirm_action">
<table>
<tr><td><label for="password">New password:</label></td><td><input type="password" id="password" name="password"/></td></tr>
</table>
<input type="submit" value="Reset"/><input type="hidden" name="id" value="{{id}}"/><input type="hidden" name="secret" value="{{secret}}"/></form>
)"};

void resetPasswordPage(Page& page) { page.body << resetPasswordTemplate.render({}); }

constexpr i64 resetSeconds = 3600;
constexpr i64 resetInterval = 600;

void resetPasswordAction(Page& page, http::HttpResponse& response)
{
  Form form(*page.request, "/reset_password");
  form.requirePost("A reset is asked for with the form.");
  String email = form.text("email");
  if (email.empty())
    form.fail("Email not provided");
  // The same answer whether the address has an account or not.
  String answer = "If an account has this address, a reset link is on its way to it.";
  mariadb::MariaDbResult found = page.query("SELECT id, TIMESTAMPDIFF(SECOND, reset_password_timestamp, NOW()) as since FROM user WHERE email=", quote(email));
  form.setTarget("/");
  if (found.empty() || !isMailAddress(email))
    form.fail(answer);
  Row user(found, 0);
  if (!user["since"].empty() && stoll(user["since"]) < resetInterval)
    form.fail(answer);
  String secret = secureRandomSecret();
  page.query("UPDATE user SET reset_password_secret=", quote(secret), ", reset_password_timestamp=now() WHERE id=", quote(user["id"]));
  sendMail(*page.config, email, "gorating.com password reset",
           resetMailTemplate.render({{"link", siteAddress(page) + "/reset_password_confirm?id=" + user["id"] + "&secret=" + secret}}));
  redirectWithMessage(response, "/", answer);
}

// The user whose reset id and secret name, while it lasts; else the reason.
Optional<String> resetProblem(Page& page, StringView id, StringView secret, mariadb::MariaDbResult& user)
{
  if (id.empty())
    return Optional<String>(String("Player id not provided"));
  user = page.query("SELECT id, reset_password_secret, TIMESTAMPDIFF(SECOND, reset_password_timestamp, NOW()) as since"
                    " FROM user WHERE id=", quote(id));
  if (user.empty())
    return Optional<String>(String("User doesn't exist"));
  Row row(user, 0);
  if (row["reset_password_secret"].empty() || row["since"].empty())
    return Optional<String>(String("User doesn't have pending password reset."));
  if (stoll(row["since"]) > resetSeconds)
    return Optional<String>(String("The password reset request timed out, it only lasts for 1 hour."));
  if (!sha256::Sha256::constantTimeEqual(row["reset_password_secret"], secret))
    return Optional<String>(String("Wrong secret."));
  return Optional<String>();
}

void resetPasswordConfirmPage(Page& page)
{
  mariadb::MariaDbResult user;
  Optional<String> problem = resetProblem(page, page.get("id"), page.get("secret"), user);
  if (problem.has_value())
  {
    page.body << pageMessageTemplate.render({{"message", *problem}});
    return;
  }
  page.body << resetConfirmTemplate.render({{"id", Row(user, 0)["id"]}, {"secret", page.get("secret")}});
}

void resetPasswordConfirmAction(Page& page, http::HttpResponse& response)
{
  Form form(*page.request, "/");
  form.requirePost("A new password is set with the form.");
  mariadb::MariaDbResult user;
  Optional<String> problem = resetProblem(page, form.text("id"), form.text("secret"), user);
  if (problem.has_value())
    form.fail(*problem);
  String password = form.text("password");
  form.setTarget(toString("/reset_password_confirm?id=", url::urlEncode(form.text("id")), "&secret=", url::urlEncode(form.text("secret"))));
  if (password.size() < 4)
    form.fail("The password needs 4 characters or more");
  page.query("UPDATE user SET password=", quote(passwordHash(password)),
             ", reset_password_secret = NULL, reset_password_timestamp = NULL WHERE id=", quote(Row(user, 0)["id"]));
  redirectWithMessage(response, "/", "Password successfully changed.");
}
