constexpr html::HtmlTemplate inviteMailTemplate{R"(You have been invited to register as {{name}} on gorating.com<br/>
If you already exist in EGD (you participated in any official tournament), ignore this email and request invitation that is connected to it.<br/>
Otherwise follow <a href="{{link}}">the link</a> to register.)"};
constexpr html::HtmlTemplate inviteExistingMailTemplate{R"(You have been invited to register as <a href="{{player}}">{{name}}</a><br/>
Follow this <a href="{{link}}">link</a> to register.)"};

void invitesPage(Page& page)
{
  if (!requireLogin(page))
    return;
  String first;
  String last;
  String pin = page.get("pin");
  if (!pin.empty())
  {
    mariadb::MariaDbResult player = page.query("SELECT first_name, last_name FROM user WHERE egd_pin=", quote(pin));
    if (!player.empty())
    {
      first = Row(player, 0)["first_name"];
      last = Row(player, 0)["last_name"];
    }
  }
  bool all = canAccessAllInvites(page);
  page.body << invitesTemplate.render(
      {{"first", first}, {"last", last}, {"own", all ? html::SafeHtml() : html::SafeHtml::escape("Your account can see only invites you created.")}});
  Table table(page, toString("invite LEFT JOIN user ON invite.user_id=user.id JOIN user as inviter ON invite.from_user_id=inviter.id",
                        (all ? String() : String(" WHERE invite.from_user_id=") + quote(userValue(page, "id")))));
  Sort primary;
  primary.column = "timestamp";
  primary.ascending = false;
  table.currentSort = Optional<Sort>(primary);
  table.addColumn("name", "Name",
                  {{"IF(user.id, user.name, CONCAT(invite.first_name, ' ', invite.last_name))", "name"}, {"user.id", "id"},
                   {"user.username", "username"}, {"user.rating", "rating"}},
                  [](const Row& row) { return row["id"].empty() ? html::SafeHtml::escape(row["name"]) : playerLink(row, ""); });
  table.addColumn("email", "Email", {{"invite.email", "email"}}, [](const Row& row) { return html::SafeHtml::escape(row["email"]); });
  if (all)
    table.addColumn("inviter_name", "Inviter",
                    {{"inviter.name", "inviter_name"}, {"inviter.id", "inviter_id"}, {"inviter.username", "inviter_username"},
                     {"inviter.rating", "inviter_rating"}},
                    [](const Row& row) { return playerLink(row, "inviter"); });
  Page* p = &page;
  table.addColumn("invite", "Invite link", {{"invite.id", "invite_id"}, {"invite.secret", "invite_secret"}},
                  [p](const Row& row) { return html::SafeHtml::escape(inviteAddress(*p, row["invite_id"], row["invite_secret"])); });
  table.addColumn("timestamp", "Timestamp", {{"invite.timestamp", "timestamp"}},
                  [](const Row& row) { return html::SafeHtml::escape(showDate(row["timestamp"], true)); });
  page.body << table.render();
}

bool canAccessAllInvites(const Page& page) { return userCanDo(page, adminLevelMod); }

void inviteAction(Page& page, http::HttpResponse& response)
{
  Form form(*page.request, "/");
  if (!loggedIn(page) || !canInvite(page))
    form.fail("Not logged in");
  form.setTarget("/invites");
  form.requirePost("An invite is made with the form.");
  String email = form.text("email");
  String first = form.text("first_name");
  String last = form.text("last_name");
  String rating = form.text("rating");
  if (email.empty())
    form.fail("Email not provided");
  if (!isMailAddress(email))
    form.fail("That is not an email address");
  if (first.empty() || last.empty())
    form.fail("A first and a last name are needed");
  if (!rating.empty() && !phpNumeric(rating).has_value())
    form.fail("The rating is a number");
  if (!page.query("SELECT id FROM user WHERE email=", quote(email)).empty())
    form.fail("Player with this email is already registered");
  String secret = secureRandomSecret();
  page.query("INSERT INTO invite(from_user_id, first_name, last_name, email, secret, rating) VALUES (",
             quote(userValue(page, "id")), ",", quote(first), ",", quote(last), ",", quote(email), ",", quote(secret), ",",
             quoteOrNull(rating), ")");
  String id = *page.db->scalar("SELECT LAST_INSERT_ID()");
  sendMail(*page.config, email, "Friendly go rating invitation",
           inviteMailTemplate.render({{"name", first + " " + last}, {"link", inviteAddress(page, id, secret)}}));
  redirectWithMessage(response, "/invites", "Invite created");
}

