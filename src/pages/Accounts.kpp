// Invites, registration and password resets (invites.php, invite_action.php,
// invite_existing_user.php, invite_existing_user_action.php, register.php, register_action.php,
// reset_password*.php, src/register_helper.php).
//
// Fixed on the way: the secrets came from rand() (predictable) and now come from the operating
// system, 128 bits instead of 31 (migrations/001 widened their columns); a reset link's hour never
// ran out (the check was inverted); the reset form said whether an address has an account; mails
// had names in them unescaped.

String siteAddress(const Page& page)
{
  if (!page.config->siteAddress.empty())
    return page.config->siteAddress;
  const String* host = page.request->header("host");
  return String(page.config->secureCookies ? "https://" : "http://") + (host != nullptr ? *host : String("localhost"));
}

String inviteAddress(const Page& page, StringView inviteId, StringView secret)
{
  return siteAddress(page) + "/register?id=" + String(inviteId) + "&secret=" + String(secret);
}

bool requireLogin(Page& page)
{
  if (loggedIn(page))
    return true;
  page.body << pageMessageTemplate.render({{"message", "Not logged in"}});
  return false;
}

