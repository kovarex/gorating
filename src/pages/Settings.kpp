// The user's display settings (settings.php, settings_action.php): rating decimals and the rating
// change format. They live in the user's row, which every request reads, so they apply at once.

constexpr html::HtmlTemplate settingsTemplate{R"(<form method="post" action="/settings_action"><table><tr><td><label for="significant_digits">Singificant digits to show in rating:</label></td><td><select id="significant_digits" name="significant_digits">{{digits}}</select></td></tr><tr><td><label for="rating_change_format">Rating change format:</label></td><td>{{format1}} <label for="format_1">1657&rarr;1667</label><br/>
{{format2}} <label for="format_2">+12 1667</label><br/>
</td></tr></table><input type="submit" value="submit"/></form>)"};
constexpr html::HtmlTemplate digitOptionTemplate{R"(<option value="{{value}}" ?selected="{{selected}}">{{value}}</option>)"};
constexpr html::HtmlTemplate formatRadioTemplate{R"(<input type="radio" id="format_{{value}}" name="rating_change_format" value="{{value}}" ?checked="{{checked}}"/>)"};

void settingsPage(Page& page)
{
  if (!loggedIn(page))
  {
    page.body << pageMessageTemplate.render({{"message", "Not logged in"}});
    return;
  }
  html::SafeHtml digits;
  for (i32 i = 0; i <= 3; ++i)
    digits << digitOptionTemplate.render({{"value", i}, {"selected", i == ratingDigits}});
  page.body << settingsTemplate.render(
      {{"digits", digits},
       {"format1", formatRadioTemplate.render({{"value", 1}, {"checked", ratingChangeFormat != 2}})},
       {"format2", formatRadioTemplate.render({{"value", 2}, {"checked", ratingChangeFormat == 2}})}});
}

void settingsAction(Page& page, http::HttpResponse& response)
{
  Form form(*page.request, "/");
  if (!loggedIn(page))
    form.fail("Not logged in");
  if (page.request->method != "POST")
  {
    response.redirect("/settings");
    return;
  }
  form.setTarget("/settings");
  u8 digits = form.number<u8>("significant_digits", "Significant digits are 0 to 3");
  if (digits > 3)
    form.fail("Significant digits are 0 to 3");
  u8 format = form.number<u8>("rating_change_format", "Invalid rating change format value");
  if (format != 1 && format != 2)
    form.fail("Invalid rating change format value");
  page.query("UPDATE user SET setting_significant_digits_in_rating=", digits, ", setting_rating_change_format=", format,
             " WHERE id=", quote(userValue(page, "id")));
  response.redirect("/");
}
