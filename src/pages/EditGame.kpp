// Editing a game (edit_game.php, edit_game_action.php): who won (mods), colours, handicap, komi,
// location, time and the SGF, each change in the change log, then the rating update. An admin edits
// any game; a player their own for a day after it (PHP called canEditMyGameSince, which does not
// exist, so a player's own edit ended in a PHP error). The values are checked before they reach SQL.

constexpr html::HtmlTemplate editGameTemplate{R"(<form method="post" action="/edit_game_action" enctype="multipart/form-data">
<table>
<tr>
<td>{{winner}}</td>
{{winnerChoice}}<td><select id="original_winner_color" name="original_winner_color" oninput="fixColors(this);"><option value="black" ?selected="{{winnerBlack}}">Black</option><option value="white" ?selected="{{loserBlack}}">White</option></select></td>
</tr>
<tr>
<td>{{loser}}</td>
{{loserChoice}}<td><select id="original_loser_color" name="original_loser_color" oninput="fixColors(this);"><option value="black" ?selected="{{loserBlack}}">Black</option><option value="white" ?selected="{{winnerBlack}}">White</option></select></td>
</tr>
<tr><td><label for="handicap">Handicap:</label></td><td colspan="2"><input type="text" name="handicap" value="{{handicap}}"/></td></tr>
<tr><td><label for="komi">Komi:</label></td><td colspan="2"><input type="text" id="komi" name="komi" value="{{komi}}"/></td></tr>
<tr><td><label for="location">Location:</label></td><td colspan="2"><input type="text" id="location" name="location" value="{{location}}"/></td></tr>
<tr><td><label for="timestamp">Timestamp:</label></td><td colspan="2"><input type="text" id="timestamp" name="timestamp" value="{{timestamp}}"/></td></tr>
<tr><td><label for="sgf">SGF(currently {{sgfState}}present:</label></td><td colspan="2"><input type="file" name="sgf" accept=".sgf"/></td></tr>
{{deleteSgf}}</table>
<input type="hidden" name="id" value="{{id}}"/>
<input type="hidden" name="redirect" value="{{redirect}}"/>
<input type="submit" value="Confirm changes"/>
</form>
<script>
function fixColors(caller)
{
  if (caller.id == 'original_winner_color')
    document.getElementById('original_loser_color').value = caller.value == 'black' ? 'white' : 'black';
  else if (caller.id == 'original_loser_color')
    document.getElementById('original_winner_color').value = caller.value == 'white' ? 'black' : 'white';
}
function fixWinner(caller)
{
  if (caller.id == 'original_winner')
    document.getElementById('original_loser').value = caller.value == 'winner' ? 'loser' : 'winner';
  else if (caller.id == 'original_loser')
    document.getElementById('original_winner').value = caller.value == 'loser' ? 'winner' : 'loser';
}
</script>
)"};

// Who won, for a player's row (side "winner" or "loser"): mods may switch them.
constexpr html::HtmlTemplate resultChoiceTemplate{R"(<td><select id="original_{{side}}" name="original_{{side}}" oninput="fixWinner(this);"><option value="winner" ?selected="{{won}}">Winner</option><option value="loser" ?selected="{{lost}}">Loser</option></select></td>
)"};

constexpr html::HtmlTemplate deleteSgfTemplate{R"(<tr><td></td><td colspan="2"><input type="checkbox" id="delete-sgf" name="delete-sgf"/><label for="delete-sgf">Delete Current sgf</label></td></tr>
)"};

bool canEditWinner(const Page& page) { return userCanDo(page, adminLevelMod); }

// Whether the user may edit this game: an admin any, a player their own for a day after it.
bool mayEditGame(Page& page, StringView winnerId, StringView loserId, StringView gameId)
{
  if (canEditAnyGame(page))
    return true;
  String userId = userValue(page, "id");
  if (!loggedIn(page) || (userId != winnerId && userId != loserId))
    return false;
  Optional<String> age = page.db->scalar("SELECT TIMESTAMPDIFF(SECOND, timestamp, NOW()) FROM game WHERE id=", quote(gameId));
  return age.has_value() && stoll(*age) < 24 * 3600;
}

void editGamePage(Page& page)
{
  String id = page.get("id");
  mariadb::MariaDbResult found = page.query("SELECT winner.id as winner_id, winner.name as winner_name, winner.username as winner_username,"
                                            " game.winner_old_rating as winner_rating, game.winner_old_egd_rating as winner_egd_rating,"
                                            " loser.id as loser_id, loser.name as loser_name, loser.username as loser_username,"
                                            " game.loser_old_rating as loser_rating, game.loser_old_egd_rating as loser_egd_rating,"
                                            " game.winner_is_black as winner_is_black, game.handicap as handicap, game.komi as komi,"
                                            " game.location as location, game.timestamp as timestamp, length(game.sgf) > 0 has_sgf"
                                            " FROM game JOIN user as winner ON game.winner_user_id = winner.id JOIN user as loser ON game.loser_user_id = loser.id"
                                            " WHERE game.id=", quote(id));
  if (found.empty())
  {
    page.body << html::SafeHtml::escape(toString("Unknown game with id=", id));
    return;
  }
  Row row(found, 0);
  if (!mayEditGame(page, row["winner_id"], row["loser_id"], id))
  {
    page.body << pageMessageTemplate.render({{"message", "You can't edit this game."}});
    return;
  }
  bool winnerIsBlack = row["winner_is_black"] == "1";
  bool hasSgf = row["has_sgf"] == "1";
  page.body << editGameTemplate.render(
      {{"winner", playerLink(row, "winner")},
       {"winnerChoice", canEditWinner(page) ? resultChoiceTemplate.render({{"side", "winner"}, {"won", true}, {"lost", false}}) : html::SafeHtml()},
       {"winnerBlack", winnerIsBlack},
       {"loser", playerLink(row, "loser")},
       {"loserChoice", canEditWinner(page) ? resultChoiceTemplate.render({{"side", "loser"}, {"won", false}, {"lost", true}}) : html::SafeHtml()},
       {"loserBlack", !winnerIsBlack},
       {"handicap", row["handicap"]},
       {"komi", row["komi"]},
       {"location", row["location"]},
       {"timestamp", row["timestamp"]},
       {"sgfState", hasSgf ? "" : "not "},
       {"deleteSgf", hasSgf ? deleteSgfTemplate.render({}) : html::SafeHtml()},
       {"id", id},
       {"redirect", localRedirect(page.get("redirect"), toString("/game?id=", id))}});
}

// "YYYY-MM-DD HH:MM:SS", the form MariaDB writes a timestamp in.
bool isTimestamp(StringView text)
{
  if (text.size() != 19)
    return false;
  for (ContainerSize i = 0; i < 19; ++i)
  {
    char c = text[i];
    bool separator = i == 4 || i == 7 || i == 10 || i == 13 || i == 16;
    char expected = i == 4 || i == 7 ? '-' : i == 10 ? ' ' : ':';
    if (separator ? c != expected : (c < '0' || c > '9'))
      return false;
  }
  return true;
}

// A player's gorating rating before and after a game, from its row: "1950.2→1961.0"; "" when the
// game gives them none (a player with only an EGD rating).
String gameRatingChange(const Row& game, StringView userId)
{
  String side = game["winner_user_id"] == userId ? "winner" : "loser";
  if (game.isNull(side + "_old_rating") || game.isNull(side + "_new_rating"))
    return String();
  return showRating(game[side + "_old_rating"]) + "→" + showRating(game[side + "_new_rating"]);
}

// What the edit did to the game's own ratings (kovarex, 2026-11-04), once the rating update
// recomputed it: "This game: Novák 1950.2→1961.0 (before the edit 1950.2→1941.8); ...". "" when its
// ratings did not change; that the update has not reached it yet when it has not.
String editedGameRatings(Page& page, const Row& before, StringView id)
{
  mariadb::MariaDbResult found = page.query("SELECT game.*, winner.name AS winner_name, loser.name AS loser_name FROM game"
                                            " JOIN user AS winner ON winner.id = game.winner_user_id"
                                            " JOIN user AS loser ON loser.id = game.loser_user_id WHERE game.id=",
                                            quote(id));
  if (found.empty())
    return String();
  Row after(found, 0);
  if (variable(page, "rating_update_in_progress") == "1" &&
      ratingValue(after["rating_update_version"]) < ratingValue(variable(page, "rating_update_version")))
    return "This game's ratings are not recomputed yet: the rating update has not reached it.";
  String out;
  bool changed = false;
  for (StringView side : {"winner", "loser"})
  {
    String userId = after[String(side) + "_user_id"];
    String now = gameRatingChange(after, userId);
    String then = gameRatingChange(before, userId);
    if (now.empty())
      continue;
    changed = changed || now != then;
    out << String(out.empty() ? "This game: " : "; ") + after[String(side) + "_name"] + " " + now +
               (then.empty() ? String() : toString(" (before the edit ", then, ")"));
  }
  return changed ? out + "." : String();
}

void addChange(Page& page, i32 type, StringView gameId, const Optional<String>& oldValue, const Optional<String>& newValue)
{
  String columns = "change_type_id, game_id, executed_by_user_id";
  String values = toString(type, ",", quote(gameId), ",", quote(userValue(page, "id")));
  if (oldValue.has_value())
  {
    columns << ",old_value";
    values << "," << quoteOrNull(*oldValue);
  }
  if (newValue.has_value())
  {
    columns << ",new_value";
    values << "," << quoteOrNull(*newValue);
  }
  page.query("INSERT INTO `change`(", columns, ") VALUES(", values, ")");
}

constexpr i32 changeGameWinner = 9;
constexpr i32 changeGameBlackPlayer = 10;
constexpr i32 changeGameHandicap = 11;
constexpr i32 changeGameKomi = 12;
constexpr i32 changeGameLocation = 13;
constexpr i32 changeGameSgf = 16;
constexpr i32 changeGameTimestamp = 17;

void editGameAction(Page& page, http::HttpResponse& response)
{
  Form form(*page.request, "/");
  form.requirePost("A game is edited with the edit form.");
  String id = toString(form.number<u64>("id", "Game to update doesn't exist."));
  mariadb::MariaDbResult found = page.query("SELECT * FROM game WHERE id=", id);
  if (found.empty())
    form.fail("Game to update doesn't exist.");
  String redirect = localRedirect(form.text("redirect"), toString("/game?id=", id));
  form.setTarget(redirect);
  Row game(found, 0);
  if (!mayEditGame(page, game["winner_user_id"], game["loser_user_id"], id))
    form.fail("You can't edit this game; a mod can.");

  bool originalWinnerIsBlack = game["winner_is_black"] == "1";
  String winnerId = game["winner_user_id"];
  String loserId = game["loser_user_id"];
  bool winnerIsBlack = originalWinnerIsBlack;
  String originalWinner = form.text("original_winner");
  bool switched = !originalWinner.empty() && originalWinner != "winner";
  if (switched)
  {
    if (!canEditWinner(page))
      form.fail("Can't edit winner.");
    swap(winnerId, loserId);
    winnerIsBlack = !winnerIsBlack;
  }
  if ((form.text("original_winner_color") == "black") != originalWinnerIsBlack)
    winnerIsBlack = !winnerIsBlack;

  u8 handicap = form.number<u8>("handicap", "Handicap is a whole number from 0 to 9");
  if (handicap > 9)
    form.fail("Handicap is a whole number from 0 to 9");
  double komi = form.decimal("komi", "Komi value must be numeric");
  String timestamp = form.text("timestamp");
  if (!isTimestamp(timestamp))
    form.fail("The timestamp is written YYYY-MM-DD HH:MM:SS");
  String location = form.text("location");
  bool deleteSgf = !form.text("delete-sgf").empty();
  Optional<String> sgf = form.file("sgf");

  page.db->begin();
  String set = toString("winner_user_id=", quote(winnerId), ",loser_user_id=", quote(loserId),
               ",winner_is_black=", winnerIsBlack, ",handicap=", handicap, ",komi=", komi,
               ",location=", quoteOrNull(location), ",timestamp=", quote(timestamp));
  if (switched)
  {
    // The two players' rating columns change places (as PHP did: the new ones become the old ones
    // until the rating update recomputes them).
    auto value = [&game](StringView column) { return game.isNull(column) ? String("NULL") : quoteOrNull(game[column]); };
    set << ", winner_old_egd_rating=" << value("loser_old_egd_rating") << ", winner_old_rating=" << value("loser_old_rating") <<
               ", winner_new_egd_rating=" << value("loser_old_egd_rating") << ", winner_new_rating=" << value("loser_old_rating") <<
               ", loser_old_egd_rating=" << value("winner_old_egd_rating") << ", loser_old_rating=" << value("winner_old_rating") <<
               ", loser_new_egd_rating=" << value("winner_new_egd_rating") << ", loser_new_rating=" << value("winner_new_rating");
  }
  if (sgf.has_value())
    set << ", sgf=" << quoteOrNull(*sgf);
  else if (deleteSgf)
    set << ",sgf=null";
  page.query("UPDATE game SET ", set, " WHERE game.id=", id);

  Vector<String> changes;
  if (game["winner_user_id"] != winnerId)
  {
    changes.push_back("Winner was changed.");
    addChange(page, changeGameWinner, id, Optional<String>(), Optional<String>());
  }
  if ((originalWinnerIsBlack != winnerIsBlack) != (game["winner_user_id"] != winnerId))
  {
    changes.push_back("Black color player was changed.");
    addChange(page, changeGameBlackPlayer, id, Optional<String>(), Optional<String>());
  }
  // Compared as numbers, as PHP compared numeric strings ("2" is "2.0").
  if (ratingValue(game["handicap"]) != handicap)
  {
    changes.push_back(toString("Handicap was changed from ", game["handicap"], " to ", handicap));
    addChange(page, changeGameHandicap, id, Optional<String>(game["handicap"]), Optional<String>(toString(handicap)));
  }
  if (ratingValue(game["komi"]) != komi)
  {
    changes.push_back(toString("Komi was changed from ", game["komi"], " to ", komi));
    addChange(page, changeGameKomi, id, Optional<String>(game["komi"]), Optional<String>(toString(komi)));
  }
  if (game["location"] != location)
  {
    changes.push_back(toString("Location was changed from ", game["location"], " to ", location));
    addChange(page, changeGameLocation, id, Optional<String>(game["location"]), Optional<String>(location));
  }
  if (game["timestamp"] != timestamp)
  {
    changes.push_back(toString("Timestamp was changed from ", game["timestamp"], " to ", timestamp));
    addChange(page, changeGameTimestamp, id, Optional<String>(game["timestamp"]), Optional<String>(timestamp));
  }
  bool hadSgf = !game["sgf"].empty();
  if (sgf.has_value())
  {
    changes.push_back(hadSgf ? "SGF was updated." : "SGF was added.");
    addChange(page, changeGameSgf, id, hadSgf ? Optional<String>(game["sgf"]) : Optional<String>(), Optional<String>(*sgf));
  }
  else if (deleteSgf && hadSgf)
  {
    changes.push_back("SGF was removed");
    addChange(page, changeGameSgf, id, Optional<String>(game["sgf"]), Optional<String>());
  }
  page.db->commit();
  // A line each, as PHP's message had (its <br/>).
  String message = toString("Game id=", id, ":");
  for (const String& change : changes)
    message << "\n" << change;
  message << "\n" << processRating(page, ratingUpdateSeconds);
  String ratings = editedGameRatings(page, game, id);
  if (!ratings.empty())
    message << "\n" << ratings;
  redirectWithMessage(response, redirect, message);
}
