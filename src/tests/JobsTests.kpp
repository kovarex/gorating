// The jobs (Jobs.kpp) against the made-up data, from saved pages (no network): who may run them,
// and the hourly update_tournament_list, which queues EGD's new tournaments and processes them.

// A job as the server's shell runs it (gorating.cgi --job): its answer, its exit code checked.
String job(const GoratingConfig& config, const Vector<String>& arguments, i32 expected = 0)
{
  goratingConfig = config;
  String output;
  i32 code = jobCommand(arguments, output);
  if (code != expected)
    throw GoratingError(format("--job {} exited {}, not {}: {}", arguments.empty() ? String() : arguments[0], code, expected, output));
  return output;
}

test "the jobs: who may run them, and the tournament list"
{
  Optional<mariadb::MariaDbOptions> server = testDatabaseServer();
  if (!server.has_value())
  {
    println("skipped: GORATING_TEST_DB is not set (src/tests/TestDatabase.kpp)");
    return;
  }
  GoratingConfig config = freshTestDatabase(*server);
  saveMadeUpPages();
  config.egdPageDirectory = String(egdWork);

  // Over HTTP a visitor or an admin is refused, a secret is no key (there is none); the owner runs them.
  for (StringView who : {"visitor", "player2"})
  {
    http::HttpResponse refused = siteRequest(config, who, "GET", "/update_rating");
    check(refused.status == 403 && refused.body == "The jobs run from the server's shell (gorating.cgi --job NAME), or for the owner.\n");
  }
  check(siteRequest(config, "visitor", "GET", "/update_rating?secret=").status == 403);
  check(siteRequest(config, "visitor", "GET", "/update_rating?secret=anything").status == 403);
  check(siteRequest(config, "owner", "GET", "/update_rating").status == 200);

  // EGD's list names a known tournament and a new one: the new one is queued and processed.
  String known = dbValue(config, "SELECT egd_key FROM egd_tournament ORDER BY id LIMIT 1");
  String list = String("<pre>\n Tournament list\n ") + known + "  A  4 Known\n " + madeUpKey + "  A  4 Made-up Cup\n</pre>\n";
  writeTestFile(String(egdWork) + "/" + egdPageName(String(egdAddress) + "EGD_2_0/downloads/tlist.html", ""), list);
  String before = dbValue(config, "SELECT COUNT(*) FROM egd_tournament");
  check(job(config, {String("update_tournament_list")}).starts_with("Queued 1 tournaments.\n"));
  check(ratingValue(dbValue(config, "SELECT COUNT(*) FROM egd_tournament")) == ratingValue(before) + 1);
  check(dbValue(config, String("SELECT COUNT(*) FROM game JOIN egd_tournament ON egd_tournament.id=game.egd_tournament_id WHERE egd_key=") +
                            quote(madeUpKey)) == "6");
  check(dbValue(config, "SELECT COUNT(*) FROM egd_tournament_to_process") == "0");
  // Run again, the list queues nothing new.
  check(siteRequest(config, "owner", "GET", "/update_tournament_list").body.starts_with("Queued 0 tournaments.\n"));
}

// A made-up tournament of one player's games, as EGD's processing writes them: key, its time, and
// each round's EGD rating before and after for the player (winner) against opponent.
void madeUpEgdGames(const GoratingConfig& config, StringView player, StringView opponent, StringView key, StringView time,
                    const Vector<Pair<String, String>>& rounds)
{
  mariadb::MariaDbConnection db = mariadb::MariaDbConnection::connect(config.database);
  String gameType = db.query("SELECT game_type_id FROM egd_tournament ORDER BY id LIMIT 1").text(0, "game_type_id");
  db.query(String("INSERT INTO egd_tournament(egd_key, name, player_count, round_count, timestamp, country_id, game_type_id) VALUES(") + quote(key) +
           ", 'Made-up', 2, " + format("{}", (i64)rounds.size()) + ", " + quote(time) + ", (SELECT MIN(id) FROM country), " + gameType + ")");
  String tournament = db.query(String("SELECT id FROM egd_tournament WHERE egd_key=") + quote(key)).text(0, "id");
  for (ContainerSize i = 0; i < rounds.size(); ++i)
    db.query(String("INSERT INTO game(winner_user_id, loser_user_id, game_type_id, timestamp, winner_old_egd_rating, winner_new_egd_rating,"
                    " loser_old_egd_rating, loser_new_egd_rating, egd_tournament_id, egd_tournament_round) VALUES(") +
             String(player) + "," + String(opponent) + "," + gameType + "," + quote(time) + "," + rounds[i].first + "," + rounds[i].second +
             ",1500,1490," + tournament + "," + format("{}", (i64)(i + 1)) + ")");
}

test "EGD rating jumps between tournaments: check_rating_changes and collect_manual_rating_changes"
{
  Optional<mariadb::MariaDbOptions> server = testDatabaseServer();
  if (!server.has_value())
  {
    println("skipped: GORATING_TEST_DB is not set (src/tests/TestDatabase.kpp)");
    return;
  }
  GoratingConfig config = freshTestDatabase(*server);
  // A player with no EGD games and no rating changes yet, the only one left to check (a jump that
  // looks like an error would process its tournaments from EGD: none here).
  String player = dbValue(config, "SELECT id FROM user WHERE id NOT IN (SELECT winner_user_id FROM game WHERE winner_old_egd_rating IS NOT NULL)"
                                  " AND id NOT IN (SELECT loser_user_id FROM game WHERE loser_old_egd_rating IS NOT NULL)"
                                  " AND id NOT IN (SELECT user_id FROM rating_change) ORDER BY id LIMIT 1");
  String opponent = dbValue(config, String("SELECT id FROM user WHERE id != ") + player + " ORDER BY id LIMIT 1");
  // Tournament 1 takes them from 1950 to 2160; EGD then starts them at 2200 (their new rank's
  // rating), and after tournament 2 at a pro rank's 2760.
  madeUpEgdGames(config, player, opponent, "TJUMP1", "2021-01-10 10:00:00", {{String("1950"), String("2060")}, {String("2060"), String("2160")}});
  madeUpEgdGames(config, player, opponent, "TJUMP2", "2021-03-10 10:00:00", {{String("2200"), String("2210")}});
  madeUpEgdGames(config, player, opponent, "TJUMP3", "2021-05-10 10:00:00", {{String("2760"), String("2765")}});
  i32 firstJump = ratingJumpReason(2200, true, Optional<double>(1950.0), Optional<double>(2160.0));
  require(firstJump != ratingChangeError && ratingJumpReason(2760, true, Optional<double>(2200.0), Optional<double>(2210.0)) == ratingChangeManualEgd);
  {
    mariadb::MariaDbConnection db = mariadb::MariaDbConnection::connect(config.database);
    db.query(String("UPDATE user SET rating_change_checked = (id != ") + player + ")");
  }

  check(siteRequest(config, "visitor", "GET", "/check_rating_changes").status == 403);
  String checked = job(config, {String("check_rating_changes")});
  check(checked.starts_with(String("Remaining 1 users to check.\nuser_id=") + player + "\n"));
  check(checked.find("Rating jumped from 2160 to 2200 in tournament TJUMP2 round 1\n") != String::npos);
  check(checked.find("Rating jumped from 2210 to 2760 in tournament TJUMP3 round 1\n") != String::npos);
  String changes = String("SELECT CONCAT(old_egd_rating, ' ', new_egd_rating, ' ', rating_change_type_id, ' ', timestamp) FROM rating_change WHERE user_id=") +
                   player + " ORDER BY timestamp";
  // Each jump dated by the tournament before it.
  check(dbValue(config, changes) == format("2160 2200 {} 2021-01-10 10:00:00", firstJump));
  check(dbValue(config, String("SELECT COUNT(*) FROM rating_change WHERE user_id=") + player) == "2");
  check(dbValue(config, String("SELECT CONCAT(old_egd_rating, ' ', new_egd_rating, ' ', rating_change_type_id) FROM rating_change WHERE user_id=") + player +
                " ORDER BY timestamp DESC LIMIT 1") == format("2210 2760 {}", ratingChangeManualEgd));
  check(dbValue(config, String("SELECT rating_change_checked FROM user WHERE id=") + player) == "1");
  check(job(config, {String("check_rating_changes")}) == "Remaining 0 users to check.\n");

  // Collected again by hand, by id or username: the recorded jumps are known, nothing is added.
  String username = dbValue(config, String("SELECT IFNULL(username, '') FROM user WHERE id=") + player);
  check(job(config, {String("collect_manual_rating_changes"), String("id=") + player}) == String("user_id=") + player + "\n");
  if (!username.empty())
    check(job(config, {String("collect_manual_rating_changes"), String("username=") + username}) == String("user_id=") + player + "\n");
  check(dbValue(config, String("SELECT COUNT(*) FROM rating_change WHERE user_id=") + player) == "2");
  check(job(config, {String("collect_manual_rating_changes")}) == "User id nor username provided\n");
  check(job(config, {String("collect_manual_rating_changes"), String("id=999999")}) == "User with id=\"999999\" doesn't exist.\n");
  check(job(config, {String("collect_manual_rating_changes"), String("username=nobody-here")}) == "User with username=\"nobody-here\" doesn't exist.\n");
}

test "the jobs from the server's shell: gorating.cgi --job NAME, no secret"
{
  Optional<mariadb::MariaDbOptions> server = testDatabaseServer();
  if (!server.has_value())
  {
    println("skipped: GORATING_TEST_DB is not set (src/tests/TestDatabase.kpp)");
    return;
  }
  GoratingConfig config = freshTestDatabase(*server);
  goratingConfig = config;
  String output;
  check(jobCommand({String("update_rating")}, output) == 0 && output == "No rating changes to process.\n");
  check(jobCommand({String("collect_manual_rating_changes")}, output) == 0 && output == "User id nor username provided\n");
  check(jobCommand({String("collect_manual_rating_changes"), String("id=999999")}, output) == 0 && output == "User with id=\"999999\" doesn't exist.\n");
  check(jobCommand(Vector<String>(), output) == 2 && output.starts_with("usage: gorating.cgi --job NAME"));
  check(jobCommand({String("about")}, output) == 2 && output.starts_with("no job about\n"));
  check(jobCommand({String("no_such_page")}, output) == 2 && output.starts_with("no job no_such_page\n"));
  // A job that fails says what went wrong and exits 1 (the cron mails it): EGD's list read from a
  // directory that has no saved copy.
  GoratingConfig noPages = config;
  noPages.egdPageDirectory = "testdata/no-such-directory";
  String failed = job(noPages, {String("update_tournament_list")}, 1);
  check(failed.starts_with("update_tournament_list failed: ") && failed.ends_with("\n"));
  goratingConfig = config;
  // Over HTTP only the owner runs them.
  check(siteRequest(config, "visitor", "GET", "/update_rating?secret=").status == 403);
  check(siteRequest(config, "owner", "GET", "/update_rating").body == "No rating changes to process.\n");
}
