// The pages that write, against the made-up data (TestDatabase.kpp): a game reported, edited,
// deleted and restored through the site's handler, and every rating it moves. The expected numbers
// come from the rating formula (Rating.kpp, which RatingTests.kpp holds to PHP's to the bit) applied
// to the ratings before the game, as PHP's report_action.php and the rating update apply it.

String goratingDbValue(const GoratingConfig& config, StringView sql)
{
  mariadb::MariaDbConnection db = mariadb::MariaDbConnection::connect(config.database);
  Optional<String> value = db.scalar(sql);
  return value.has_value() ? *value : String();
}

double userRating(const GoratingConfig& config, StringView username)
{
  return ratingValue(goratingDbValue(config, toString("SELECT rating FROM user WHERE username=", quote(username))));
}

bool nearly(double a, double b) { return a - b < 1e-9 && b - a < 1e-9; }

http::HttpResponse postForm(const GoratingConfig& config, StringView who, StringView target, StringView form)
{
  return siteRequest(config, who, "POST", target, form, "application/x-www-form-urlencoded");
}

String locationOf(const http::HttpResponse& response)
{
  for (const http::HttpHeader& h : response.headers)
    if (h.name == "Location")
      return h.value;
  return String();
}

// The rating update the change started, run to its end by its job (as the owner).
void finishRatingUpdate(const GoratingConfig& config)
{
  for (i32 i = 0; i < 100; ++i)
    if (!siteRequest(config, "owner", "GET", "/update_rating").body.starts_with("Rating update:"))
      return;
  throw GoratingError("the rating update did not finish in 100 runs of its job");
}

test "a game reported, edited, deleted and restored"
{
  Optional<mariadb::MariaDbOptions> server = testDatabaseServer();
  if (!server.has_value())
  {
    println("skipped: GORATING_TEST_DB is not set (src/tests/TestDatabase.kpp)");
    return;
  }
  GoratingConfig config = freshTestDatabase(*server);
  String me = goratingDbValue(config, "SELECT id FROM user WHERE username='player11'");
  String opponent = goratingDbValue(config, "SELECT id FROM user WHERE username='player2'");
  String lastGame = goratingDbValue(config, "SELECT MAX(id) FROM game");
  double meBefore = userRating(config, "player11");
  double opponentBefore = userRating(config, "player2");

  // A plain user may not report a win; nothing is written.
  String form = toString("winner_user_id=", opponent, "&game_type=5&handicap=0&komi=6.5&color=black&location=Brno&comment=gg");
  http::HttpResponse refused = postForm(config, "player11", "/report_action", form + "&result=win");
  check(locationOf(refused).find("Only%20trusted%20users%20report%20their%20wins") != String::npos);
  check(goratingDbValue(config, "SELECT MAX(id) FROM game") == lastGame);
  // The loss, as black, even.
  http::HttpResponse reported = postForm(config, "player11", "/report_action", form + "&result=loss");
  check(locationOf(reported) == toString("/player?id=", me, "&message=Game%20added"));
  String game = goratingDbValue(config, "SELECT MAX(id) FROM game");
  require(game != lastGame);
  double meAfter = calculateNewRating(meBefore, opponentBefore, 0, 5, 0, 0);
  double opponentAfter = calculateNewRating(opponentBefore, meBefore, 1, 5, 0, 0);
  check(goratingDbValue(config, toString("SELECT CONCAT(winner_user_id, ' ', loser_user_id, ' ', winner_is_black, ' ', handicap, ' ', komi, ' ', location, ' ', loser_comment) FROM game WHERE id=", game)) ==
        opponent + " " + me + " 0 0 6.5 Brno gg");
  check(nearly(ratingValue(goratingDbValue(config, toString("SELECT winner_new_rating FROM game WHERE id=", game))), opponentAfter));
  check(nearly(ratingValue(goratingDbValue(config, toString("SELECT loser_new_rating FROM game WHERE id=", game))), meAfter));
  check(nearly(userRating(config, "player11"), meAfter) && nearly(userRating(config, "player2"), opponentAfter));
  check(meAfter < meBefore && opponentAfter > opponentBefore);

  // The admin edits it: 2 handicap stones and komi 0.5 for black (player11). The rating update the
  // edit starts computes it again from the ratings before it.
  String timestamp = goratingDbValue(config, toString("SELECT timestamp FROM game WHERE id=", game));
  String edit = toString("id=", game, "&redirect=%2F&original_winner=winner&original_winner_color=white&handicap=2&komi=0.5&location=Brno&timestamp=",
                url::urlEncode(timestamp));
  // A user who did not play it may not (one who did may, while it is recent).
  check(locationOf(postForm(config, "player12", "/edit_game_action", edit)).find("You%20can") != String::npos);
  check(goratingDbValue(config, toString("SELECT CONCAT(handicap, ' ', komi) FROM game WHERE id=", game)) == "0 6.5");
  // The update finishes in the edit's request, whose message says what the edit did to this game's
  // ratings: player11's, then and now.
  String edited = locationOf(postForm(config, "player2", "/edit_game_action", edit));
  check(goratingDbValue(config, toString("SELECT CONCAT(handicap, ' ', komi) FROM game WHERE id=", game)) == "2 0.5");
  check(edited.find("Rating%20update%20finished%20after%20") != String::npos);
  check(edited.find("%0AThis%20game%3A%20") != String::npos && edited.find("before%20the%20edit%20") != String::npos);
  finishRatingUpdate(config);
  double meEdited = calculateNewRating(meBefore, opponentBefore, 0, 5, 2, 6);
  double opponentEdited = calculateNewRating(opponentBefore, meBefore, 1, 5, -2, -6);
  check(nearly(ratingValue(goratingDbValue(config, toString("SELECT loser_new_rating FROM game WHERE id=", game))), meEdited));
  check(nearly(ratingValue(goratingDbValue(config, toString("SELECT winner_new_rating FROM game WHERE id=", game))), opponentEdited));
  check(nearly(userRating(config, "player11"), meEdited) && nearly(userRating(config, "player2"), opponentEdited));
  check(goratingDbValue(config, toString("SELECT COUNT(*) FROM `change` WHERE game_id=", game)) != "0");

  // Deleted: the two players' ratings are as before the game; restored: as edited.
  check(locationOf(postForm(config, "player11", "/delete_game_action", toString("id=", game))).find("No%20rights") != String::npos);
  http::HttpResponse deletedResponse = postForm(config, "player2", "/delete_game_action", toString("id=", game));
  // The update finishes in that request: its message lists each player's rating before and after
  // (PHP's "Rating changes" table), a line each on the page it goes to.
  String where = locationOf(deletedResponse);
  check(where.find("deleted.%0ARating%20update%20finished%20after%20") != String::npos);
  check(where.find("Rating%20changes%3A%0A") != String::npos && where.find("Marek%20Wei%C3%9F%3A%20") != String::npos);
  String shown = siteRequest(config, "player2", "GET", where).body;
  check(shown.find("<br/>Rating changes:<br/>") != String::npos && shown.find("Marek Weiß: ") != String::npos);
  check(shown.find("→") != String::npos);
  finishRatingUpdate(config);
  check(goratingDbValue(config, toString("SELECT deleted FROM game WHERE id=", game)) == "1");
  check(nearly(userRating(config, "player11"), meBefore) && nearly(userRating(config, "player2"), opponentBefore));
  postForm(config, "player2", "/restore_game_action", toString("id=", game));
  finishRatingUpdate(config);
  check(goratingDbValue(config, toString("SELECT deleted FROM game WHERE id=", game)) == "0");
  check(nearly(userRating(config, "player11"), meEdited) && nearly(userRating(config, "player2"), opponentEdited));
}

test "a rating update moved on for a time: how far it got, then what it changed"
{
  Optional<mariadb::MariaDbOptions> server = testDatabaseServer();
  if (!server.has_value())
  {
    println("skipped: GORATING_TEST_DB is not set (src/tests/TestDatabase.kpp)");
    return;
  }
  GoratingConfig config = freshTestDatabase(*server);
  mariadb::MariaDbConnection db = mariadb::MariaDbConnection::connect(config.database);
  Page page;
  page.config = &config;
  page.db = &db;
  check(processRating(page, ratingUpdateSeconds) == "No rating changes to process.");
  // The first game deleted: its players' later games, and their opponents', are computed again.
  String first = goratingDbValue(config, "SELECT id FROM game WHERE deleted = false ORDER BY timestamp, id LIMIT 1");
  db.query("UPDATE game SET deleted=true WHERE id=", first);
  // No time and a window of 50 games read: one window, what it computed of them, and where it stopped.
  ratingUpdateWindowGames = 50;
  String progress = processRating(page, 0);
  ratingUpdateWindowGames = 5000;
  check(progress.starts_with("Rating update: ") && progress.find(" games recomputed in this request, up to the games of ") != String::npos);
  check(progress.find(" later games are left to look at (the next edit or the hourly job goes on).") != String::npos);
  String done = processRating(page, 120);
  check(done.starts_with("Rating update finished after "));
  check(done.find("\nRating changes:\n") != String::npos);
  check(processRating(page, ratingUpdateSeconds) == "No rating changes to process.");
}

test "a player who joins a rating update has their games computed again from that game on, not before"
{
  Optional<mariadb::MariaDbOptions> server = testDatabaseServer();
  if (!server.has_value())
  {
    println("skipped: GORATING_TEST_DB is not set (src/tests/TestDatabase.kpp)");
    return;
  }
  GoratingConfig config = freshTestDatabase(*server);
  mariadb::MariaDbConnection db = mariadb::MariaDbConnection::connect(config.database);
  Page page;
  page.config = &config;
  page.db = &db;
  Vector<String> ids;
  for (StringView username : {"player11", "player12", "player13", "player14"})
    ids.push_back(goratingDbValue(config, toString("SELECT id FROM user WHERE username='", username, "'")));
  // After every game of the made-up data: player11 beats player12 (the game deleted below), then
  // player13 beats player14 (no one the update changed), then player11 beats player13, which brings
  // player13 into the update.
  auto game = [&](StringView winner, StringView loser, StringView time) {
    db.query("INSERT INTO game(winner_user_id, loser_user_id, game_type_id, timestamp, winner_old_rating, winner_new_rating, loser_old_rating,"
             " loser_new_rating) VALUES(",
             String(winner), ",", loser, ",5,", quote(time), ",1500,1510,1500,1490)");
    return goratingDbValue(config, "SELECT MAX(id) FROM game");
  };
  String first = game(ids[0], ids[1], "2030-01-01 10:00:00");
  String unrelated = game(ids[2], ids[3], "2030-02-01 10:00:00");
  String joining = game(ids[0], ids[2], "2030-03-01 10:00:00");
  String before = goratingDbValue(config, toString("SELECT CONCAT(rating_update_version, ' ', winner_new_rating, ' ', loser_new_rating) FROM game WHERE id=", unrelated));
  db.query("UPDATE game SET deleted=true WHERE id=", first);
  check(processRating(page, ratingUpdateSeconds).starts_with("Rating update finished after "));
  String version = goratingDbValue(config, "SELECT value FROM variable WHERE name='rating_update_version'");
  check(goratingDbValue(config, toString("SELECT rating_update_version FROM game WHERE id=", joining)) == version);
  // player13's earlier game is the update's business only through player13, who entered it later.
  check(goratingDbValue(config, toString("SELECT CONCAT(rating_update_version, ' ', winner_new_rating, ' ', loser_new_rating) FROM game WHERE id=", unrelated)) == before);
}
