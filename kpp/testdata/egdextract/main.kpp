// Prints what gorating reads from an EGD page with its reader (src/egd/HtmlReader.kpp), in the form
// testdata/egd_extract.php prints PHP's DOMDocument reading: the two outputs must be equal.
// Usage: egdextract page.html

String egdReadFile(const char* path)
{
  FILE* file = fopen(path, "rb");
  if (!file)
  {
    fprintf(stderr, "cannot read %s\n", path);
    exit(1);
  }
  String text;
  char buffer[65536];
  for (size_t n; (n = fread(buffer, 1, 65536, file)) > 0;)
    text.append(StringView(buffer, (ContainerSize)n));
  fclose(file);
  return text;
}

int main(int argc, char** argv)
{
  if (argc != 2)
  {
    fprintf(stderr, "usage: egdextract page.html\n");
    return 2;
  }
  HtmlDocument doc = readHtml(egdReadFile(argv[1]));
  String out;
  for (int input : doc.elements(0, "input"))
  {
    const String* name = doc.attribute(input, "name");
    if (name != nullptr && !name->empty() && *name != "0")
    {
      const String* value = doc.attribute(input, "value");
      out.append(String("input\t") + *name + "\t" + (value != nullptr ? *value : String()) + "\n");
    }
  }
  for (int span : doc.elements(0, "span"))
    if (doc.hasAttribute(span, "class", "plain5"))
    {
      out.append(String("plain5\t") + doc.text(span) + "\n");
      break;
    }
  for (int div : doc.elements(0, "div"))
    if (doc.hasAttribute(div, "class", "thisdiv"))
    {
      Vector<int> bold = doc.elements(div, "b");
      Vector<int> links = doc.elements(div, "a");
      Vector<int> tables = doc.elements(div, "table");
      out.append(String("player\t") + (bold.size() > 1 ? doc.text(bold[1]) : String()) + "\t" +
                 (links.empty() ? String() : doc.text(links[0])) + "\n");
      if (tables.size() < 2)
        continue;
      for (int row : doc.elements(tables[1], "tr"))
      {
        Vector<int> cells = doc.elements(row, "td");
        if (cells.empty())
          continue;
        out.append("game");
        for (int cell : cells)
          out.append(String("\t") + doc.text(cell));
        out.append("\n");
      }
    }
  for (int table : doc.elements(0, "table"))
    if (doc.hasAttribute(table, "bordercolor", "#396B95"))
    {
      for (int row : doc.elements(table, "tr"))
      {
        Vector<int> cells = doc.elements(row, "td");
        if (!cells.empty())
          out.append(String("listed\t") + doc.text(cells[0]) + "\n");
      }
      break;
    }
  fwrite(out.data(), 1, out.size(), stdout);
  fflush(stdout);
  return 0;
}
