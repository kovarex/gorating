// EGD tournaments into games and ratings (src/process_tournament_helper.php's processTournament):
// a tournament's GoR page gives its facts and each player's block of games; each game is stored
// once (the first of its two players seen inserts it, the second fills in its side), with EGD's
// ratings and, for players registered before the tournament, gorating's own. Processing a
// tournament again (rating checks do) corrects a game whose EGD ratings changed and notes every
// difference it finds in rating_discrepancy (noteRatingDiscrepancy).
//
// Ported as PHP computes it, so the database gets the same values: the comparisons run both on the
// same saved pages (testdata/scenario-*.sh). On purpose: an opponent's whole name is kept (PHP kept
// two words); the differences are noted (kovarex, 2026-11-03: a game whose gorating ratings differ
// while its EGD ones do not is an error to notice and decide about later, so it is left as it is;
// PHP meant to correct it but compared an undefined variable).

// "31-10-2026" (EGD's tournament_date) as "2026-10-31 00:00:00" (PHP: strtotime, then date()).
String egdTimestamp(StringView date)
{
  if (date.size() != 10 || date[2] != '-' || date[5] != '-')
    throw GoratingError(format("Tournament date \"{}\" is not DD-MM-YYYY", date));
  return String(date.substr(6, 4)) + "-" + String(date.substr(3, 2)) + "-" + String(date.substr(0, 2)) + " 00:00:00";
}

// Pins of the two players and a round: the game id stored for them (PHP's $pinsProcessed).
struct ProcessedGame
{
  String playerPin;
  String opponentPin;
  String round;
  String gameId;
};

const String* processedGame(const Vector<ProcessedGame>& processed, StringView playerPin, StringView opponentPin, StringView round)
{
  for (const ProcessedGame& g : processed)
    if (g.playerPin == playerPin && g.opponentPin == opponentPin && g.round == round)
      return &g.gameId;
  return nullptr;
}

// Whether a and b differ by more than PHP's tolerance (PHP: abs($a - $b) <= 0.0001).
bool egdDiffers(StringView a, double b) { return !(ratingValue(a) - b <= 0.0001 && b - ratingValue(a) <= 0.0001); }

// Whether a stored rating (none for NULL) and a computed one (none when gorating's is not kept) differ.
bool ratingDiffers(const Optional<String>& stored, const Optional<PhpNumber>& computed)
{
  if (!stored.has_value() || !computed.has_value())
    return stored.has_value() != computed.has_value();
  return egdDiffers(*stored, computed->value);
}

String sqlOrNull(const Optional<PhpNumber>& n) { return n.has_value() ? n->sql() : String("NULL"); }

// What processing a tournament again found: kind is 'egd' (EGD's ratings changed), 'own' (gorating's
// computed again differ) or 'added' (a game EGD did not have before). Found again, the row gets the
// latest values (migrations/001).
void noteRatingDiscrepancy(Page& page, StringView gameId, StringView userId, StringView kind, const Optional<String>& storedOld,
                           const Optional<String>& storedNew, const Optional<PhpNumber>& computedOld,
                           const Optional<PhpNumber>& computedNew, bool corrected)
{
  page.query(String("INSERT INTO rating_discrepancy(game_id, user_id, kind, stored_old, stored_new, computed_old, computed_new, corrected)"
                    " VALUES(") +
             quote(gameId) + "," + quote(userId) + "," + quote(kind) + "," + mariadb::mariaDbQuoteOrNull(storedOld) + "," +
             mariadb::mariaDbQuoteOrNull(storedNew) + "," + sqlOrNull(computedOld) + "," + sqlOrNull(computedNew) + "," +
             (corrected ? "true" : "false") +
             ") ON DUPLICATE KEY UPDATE stored_old=VALUES(stored_old), stored_new=VALUES(stored_new), computed_old=VALUES(computed_old),"
             " computed_new=VALUES(computed_new), corrected=VALUES(corrected), last_seen=CURRENT_TIMESTAMP");
}

// A player's side of a game already stored, when its tournament is processed again (stored: its
// old, new, old_egd and new_egd ratings and deleted): corrected when EGD's ratings changed, as PHP
// did; every difference noted. A deleted game does not count (kovarex, 2026-11-02): its gorating
// ratings are neither checked nor written, and true says the player's rating stays as before it.
// written becomes true when the game was written.
bool checkStoredGame(Page& page, bool& written, const mariadb::MariaDbResult& stored, StringView gameId, StringView userId, StringView prefix,
                     const PhpNumber& oldGor, const PhpNumber& newGor, const Optional<PhpNumber>& oldOwn,
                     const Optional<PhpNumber>& newOwn, StringView ownRatings)
{
  Row row(stored, 0);
  bool deleted = phpTrue(stored.at(0, "deleted"));
  bool egdChanged = egdDiffers(row["old_egd"], oldGor.value) || egdDiffers(row["new_egd"], newGor.value);
  if (egdChanged)
  {
    written = true;
    page.query(String("UPDATE game SET ") + String(prefix) + "old_egd_rating=" + oldGor.sql() + ", " + String(prefix) +
               "new_egd_rating=" + newGor.sql() + (deleted ? String() : String(ownRatings)) + " WHERE id=" + String(gameId));
    noteRatingDiscrepancy(page, gameId, userId, "egd", stored.at(0, "old_egd"), stored.at(0, "new_egd"), Optional<PhpNumber>(oldGor),
                          Optional<PhpNumber>(newGor), true);
  }
  if (!deleted && (ratingDiffers(stored.at(0, "old"), oldOwn) || ratingDiffers(stored.at(0, "new"), newOwn)))
    noteRatingDiscrepancy(page, gameId, userId, "own", stored.at(0, "old"), stored.at(0, "new"), oldOwn, newOwn,
                          egdChanged && newOwn.has_value());
  return deleted;
}

// Processes the tournament of key, or the first one queued in egd_tournament_to_process when key is
// empty. False when there was none queued; a page or a database that does not fit throws, and the
// tournament's changes are rolled back.
bool processTournament(Page& page, String key)
{
  if (key.empty())
  {
    mariadb::MariaDbResult queued = page.query("SELECT egd_key FROM egd_tournament_to_process ORDER BY id LIMIT 1");
    if (queued.empty())
      return false;
    key = Row(queued, 0)["egd_key"];
  }
  mariadb::MariaDbResult existing = page.query(String("SELECT * FROM egd_tournament WHERE egd_key =") + quote(key));
  EgdTournamentPage egd = readEgdTournamentPage(readHtml(fetchEgd(*page.config, String(egdAddress) + "Tournament_ShowGoR.php?key=" + key)), key);
  Optional<EgdCountry> country = Optional<EgdCountry>(egdCountry(page, egd.nation));
  int gameType = egd.gameType;
  Optional<String> city = Optional<String>(egd.city);
  Optional<String> tournamentName = egd.name;
  String playerCount = egd.playerCount;
  String roundCount = egd.roundCount;
  String timestamp = egdTimestamp(egd.date);

  page.db->begin();
  try
  {
    bool existed = !existing.empty();
    String tournamentId;
    if (!existed)
    {
      page.query(String("INSERT INTO egd_tournament(egd_key, timestamp, country_id, game_type_id, city, name, player_count, round_count) VALUES(") +
                 quote(key) + "," + quote(timestamp) + "," + quote(country->id) + "," + quote(format("{}", gameType)) + "," +
                 quoteOrNull(*city) + "," + (tournamentName.has_value() ? quoteOrNull(*tournamentName) : String("NULL")) + "," +
                 quoteOrNull(playerCount) + "," + quoteOrNull(roundCount) + ")");
      tournamentId = *page.db->scalar("SELECT LAST_INSERT_ID()");
    }
    else
      tournamentId = Row(existing, 0)["id"];
    page.query(String("DELETE FROM egd_tournament_to_process WHERE egd_key=") + quote(key));

    int placement = 1;
    Vector<ProcessedGame> processed;
    Vector<String> usersToUpdate;
    // Each player's rating before the tournament (gorating's, else EGD's), and whether a game was
    // written: for the update of their later games below.
    Vector<Pair<String, String>> starts;
    bool written = false;
    for (const EgdTournamentPlayer& player : egd.players)
    {
      String gorText = player.gor;
      PhpNumber currentGor = PhpNumber::read(gorText);
      String playerPin = player.pin;
      String userId = addEgdPlayerIfNotPresent(page, playerPin, player.firstName, player.lastName);
      mariadb::MariaDbResult userResult = page.query(String("SELECT * from user WHERE user.id=") + quote(userId));
      Row user(userResult, 0);
      if (!existed)
        page.query(format("INSERT INTO egd_tournament_result(egd_tournament_id, user_id, placement) VALUES({},{},{})", quote(tournamentId),
                          quote(userId), quote(format("{}", placement))));
      // gorating's own rating moves only for players registered before the tournament.
      Optional<PhpNumber> userRating;
      Optional<String> userStartRating;
      if (!user["register_timestamp"].empty() && user["register_timestamp"] < timestamp)
      {
        Optional<String> before = fetchUserRatingBefore(page, user, userId, Optional<String>(timestamp), Optional<String>(tournamentId),
                                                        Optional<String>(), false);
        if (before.has_value())
        {
          userRating = Optional<PhpNumber>(PhpNumber::read(*before));
          userStartRating = before;
        }
      }
      ++placement;
      starts.push_back(Pair<String, String>(userId, userStartRating.has_value() ? *userStartRating : gorText));

      for (const EgdTournamentGame& row : player.games)
      {
        String round = row.round;
        PhpNumber gorChange = PhpNumber::read(row.gorChange);
        String color = row.color;
        String handicap = row.handicap;
        double handicapValue = ratingValue(handicap);
        double komi = handicapValue == 0 ? 6.5 : 0.5;
        bool jigo = row.result == "Jigo";
        String opponentPin = row.opponentPin;
        // A jigo is stored with the player seen first as its winner.
        bool userWon = jigo ? processedGame(processed, opponentPin, playerPin, round) == nullptr : row.result == "Win";
        String opponentId = addEgdPlayerIfNotPresent(page, opponentPin, row.opponentFirstName, row.opponentLastName);
        String opponentGorText = row.opponentGor;
        PhpNumber opponentGor = PhpNumber::read(opponentGorText);
        PhpNumber opponentGorChange = PhpNumber::read(row.opponentGorChange);

        String winnerId = userWon ? userId : opponentId;
        String loserId = userWon ? opponentId : userId;
        PhpNumber winnerOldGor = userWon ? currentGor : opponentGor;
        PhpNumber winnerNewGor = userWon ? currentGor + gorChange : opponentGor + opponentGorChange;
        PhpNumber loserOldGor = userWon ? opponentGor : currentGor;
        PhpNumber loserNewGor = userWon ? opponentGor + opponentGorChange : currentGor + gorChange;
        bool winnerIsBlack = userWon == (color == "b");
        String prefix = userWon ? "winner_" : "loser_";

        Optional<PhpNumber> oldUserRating;
        if (userRating.has_value())
        {
          oldUserRating = userRating;
          Optional<String> opponentRating = fetchUserRatingBefore(page, opponentId, Optional<String>(timestamp), Optional<String>(tournamentId),
                                                                  Optional<String>(opponentGorText));
          double start = ratingValue(*userStartRating);
          double delta = calculateNewRating(start, ratingValue(opponentRating.value_or(String())), jigo ? 0.5 : (userWon ? 1 : 0), gameType,
                                            color == "b" ? handicapValue : -handicapValue, (color == "b" ? -1 : 1) * (komi - 6.5)) -
                         start;
          userRating = Optional<PhpNumber>(PhpNumber::of(userRating->value + delta));
        }
        String ownRatings = userRating.has_value()
                                ? String(",") + prefix + "old_rating=" + oldUserRating->sql() + "," + prefix + "new_rating=" + userRating->sql()
                                : String();
        PhpNumber newGor = currentGor + gorChange;
        String gameId;
        if (const String* seen = processedGame(processed, opponentPin, playerPin, round))
        {
          // The opponent's block came first and stored the game: this player's side of it.
          String id = *seen;
          if (!existed)
            page.query(String("UPDATE game SET ") + prefix + "old_egd_rating=" + currentGor.sql() + "," + prefix + "new_egd_rating=" +
                       newGor.sql() + ownRatings + " WHERE id=" + id);
          else if (checkStoredGame(page, written,
                                   page.query(String("SELECT ") + prefix + "old_rating as old, " + prefix + "new_rating as new, " + prefix +
                                              "old_egd_rating as old_egd, " + prefix + "new_egd_rating as new_egd, deleted FROM game WHERE id=" + id),
                                   id, userId, prefix, currentGor, newGor, oldUserRating, userRating, ownRatings))
            userRating = oldUserRating;
          gameId = id;
        }
        else
        {
          mariadb::MariaDbResult stored;
          if (existed)
            stored = page.query(String("SELECT id, ") + prefix + "old_rating as old, " + prefix + "new_rating as new, " + prefix +
                                "old_egd_rating as old_egd, " + prefix + "new_egd_rating as new_egd, deleted FROM game WHERE egd_tournament_id=" +
                                quote(tournamentId) + " and egd_tournament_round=" + quote(round) + " and winner_user_id=" + quote(winnerId));
          if (!existed || stored.empty())
          {
            page.query(String("INSERT INTO game(winner_user_id, loser_user_id, game_type_id, timestamp, winner_old_egd_rating, winner_new_egd_rating,"
                              " loser_old_egd_rating, loser_new_egd_rating,") +
                       (userRating.has_value() ? (userWon ? " winner_old_rating, winner_new_rating," : " loser_old_rating, loser_new_rating,") : "") +
                       " winner_is_black, handicap, komi, egd_tournament_id, egd_tournament_round, jigo) VALUES(" + winnerId + "," + loserId +
                       "," + format("{}", gameType) + "," + quote(timestamp) + "," + quote(winnerOldGor.sql()) + "," +
                       quote(winnerNewGor.sql()) + "," + quote(loserOldGor.sql()) + "," + quote(loserNewGor.sql()) + "," +
                       (userRating.has_value() ? oldUserRating->sql() + "," + userRating->sql() + "," : String()) +
                       (winnerIsBlack ? "true" : "false") + "," + quoteOrNull(handicap) + "," + quote(phpNumber(komi)) + "," +
                       quote(tournamentId) + "," + quote(round) + "," + (jigo ? "true" : "false") + ")");
            gameId = *page.db->scalar("SELECT LAST_INSERT_ID()");
            written = true;
            if (existed)
              noteRatingDiscrepancy(page, gameId, userId, "added", Optional<String>(), Optional<String>(), Optional<PhpNumber>(currentGor),
                                    Optional<PhpNumber>(newGor), true);
          }
          else
          {
            if (stored.size() > 1)
              throw GoratingError("Processing existing tournament, but there are more games with the parameters.");
            gameId = Row(stored, 0)["id"];
            if (checkStoredGame(page, written, stored, gameId, userId, prefix, currentGor, newGor, oldUserRating, userRating, ownRatings))
              userRating = oldUserRating;
          }
        }
        currentGor = newGor;
        processed.push_back(ProcessedGame{playerPin, opponentPin, round, gameId});
      }
      bool listed = false;
      for (const String& id : usersToUpdate)
        if (id == userId)
          listed = true;
      if (!listed)
        usersToUpdate.push_back(userId);
    }
    for (const String& id : usersToUpdate)
      updateFinalRating(page, id);
    // A tournament EGD adds or corrects after its players' later games were computed: those games
    // are recomputed (kovarex, 2026-11-03: ratings have to match), by the rating update a deleted
    // or edited game starts, from each player's rating before the tournament.
    if (written)
      for (const Pair<String, String>& start : starts)
        if (!page.query(String("SELECT id FROM game WHERE deleted = false and timestamp >= ") + quote(timestamp) +
                        " and (egd_tournament_id is null or egd_tournament_id != " + quote(tournamentId) + ") and (winner_user_id=" +
                        quote(start.first) + " or loser_user_id=" + quote(start.first) + ") LIMIT 1")
                 .empty())
          page.query(String("CALL start_rating_update(") + start.first + "," + start.second + "," + start.first + "," + start.second +
                     ",STR_TO_DATE(" + quote(timestamp) + ",'%Y-%m-%d %H:%i:%s'))");
    page.db->commit();
  }
  catch (const Exception& e)
  {
    page.db->rollback();
    throw;
  }
  return true;
}

// The user's rating and EGD rating from their latest game (src/rating_helper.php's updateFinalRating).
void updateFinalRating(Page& page, StringView userId)
{
  mariadb::MariaDbResult found = page.query(String("SELECT * FROM user where id=") + quote(userId));
  Row user(found, 0);
  Optional<String> rating = fetchUserRatingBefore(page, user, userId, Optional<String>(), Optional<String>(), Optional<String>(), false);
  Optional<String> egdRating = fetchUserRatingBefore(page, user, userId, Optional<String>(), Optional<String>(), Optional<String>(), true);
  Optional<String> current = found.at(0, "rating");
  Optional<String> currentEgd = found.at(0, "egd_rating");
  if (!phpLooseEqual(current, rating) || !phpLooseEqual(currentEgd, egdRating))
    page.query(String("UPDATE user SET  rating=") + mariadb::mariaDbQuoteOrNull(rating) + ",egd_rating=" +
               mariadb::mariaDbQuoteOrNull(egdRating) + " WHERE user.id=" + quote(userId));
}
