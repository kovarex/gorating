// One EGD tournament (tournament.php): its facts, and the cross table of its games by placement.

constexpr html::HtmlTemplate tournamentTemplate(R"(<h1>{{name}}</h1><table class="centered-table"><tr><td>EGD:</td><td>{{egd}}</td></tr><tr><td>Date:</td><td>{{date}}</td></tr><tr><td>Type:</td><td>{{type}}</td></tr><tr><td>Players:</td><td>{{players}}</td></tr><tr><td>Country:</td><td>{{country}}</td></tr><tr><td>City:</td><td>{{city}}</td></tr></table><br/><table class="data-table"><tr><th>Placement</th>{{rounds}}</tr>{{rows}}</table>)");
constexpr html::HtmlTemplate roundHeaderTemplate(R"(<th>Round {{round}}</th>)");
constexpr html::HtmlTemplate placementRowTemplate(R"(<tr><td>{{placement}}. {{player}}</td>{{cells}}</tr>)");
constexpr html::HtmlTemplate plainCellTemplate(R"(<td>{{content}}</td>)");

// A game in the cross table, as the row of one of its players shows it.
struct TournamentCell
{
  bool present = false;
  PlayerRef opponent;
  String result; // WIN, LOSS or JIGO
  bool hasSgf = false;
  String gameId;
};

void tournamentPage(Page& page)
{
  String id = page.get("id");
  if (id.empty())
  {
    page.body.append(html::SafeHtml::escape("ID not specified."));
    return;
  }
  mariadb::MariaDbResult found = page.query(
      String("SELECT egd_tournament.*, country.name as country_name, game_type.name as game_type_name"
             " FROM egd_tournament JOIN country ON egd_tournament.country_id = country.id"
             " JOIN game_type ON egd_tournament.game_type_id = game_type.id WHERE egd_tournament.id=") + quote(id));
  if (found.empty())
  {
    page.body.append(html::SafeHtml::escape(String("Tournament with id=") + id + " not found."));
    return;
  }
  Row tournament(found, 0);
  int rounds = (int)stoll(tournament["round_count"]);
  int players = (int)stoll(tournament["player_count"]);

  mariadb::MariaDbResult games = page.query(
      String("SELECT game.id as game_id, game.winner_user_id as winner_id, winner.name as winner_name,"
             " winner.username as winner_username, game.winner_old_rating as winner_rating,"
             " game.winner_old_egd_rating as winner_egd_rating, game.loser_user_id as loser_id,"
             " loser.name as loser_name, loser.username as loser_username, game.loser_old_rating as loser_rating,"
             " game.loser_old_egd_rating as loser_egd_rating, game.egd_tournament_round as round,"
             " winner_result.placement as winner_placement, loser_result.placement as loser_placement,"
             " game.jigo as jigo, length(game.sgf) > 0 as has_sgf"
             " FROM game, user as loser, user as winner, egd_tournament_result as winner_result,"
             " egd_tournament_result as loser_result"
             " WHERE game.deleted = false and game.egd_tournament_id=") + quote(id) +
      " and game.winner_user_id = winner.id and winner_result.user_id = winner.id and winner_result.egd_tournament_id =" +
      quote(id) + " and game.loser_user_id = loser.id and loser_result.user_id = loser.id and loser_result.egd_tournament_id =" +
      quote(id) + " ORDER BY LEAST(winner_result.placement, loser_result.placement), game.egd_tournament_round");

  // cells[placement][round], placements[placement]: 1-based, as the PHP arrays.
  Vector<Vector<TournamentCell>> cells(players + 1, Vector<TournamentCell>(rounds + 1));
  Vector<Optional<PlayerRef>> placements(players + 1);
  for (ContainerSize i = 0; i < games.size(); ++i)
  {
    Row row(games, i);
    int round = (int)stoll(row["round"]);
    int winnerPlacement = (int)stoll(row["winner_placement"]);
    int loserPlacement = (int)stoll(row["loser_placement"]);
    if (round < 1 || round > rounds || winnerPlacement < 1 || winnerPlacement > players || loserPlacement < 1 ||
        loserPlacement > players)
      throw GoratingError(format("the game {} of tournament {} is outside its rounds or placements", row["game_id"], id));
    bool jigo = row["jigo"] == "1";
    PlayerRef winner = playerRef(row, "winner");
    PlayerRef loser = playerRef(row, "loser");
    for (bool winnersRow : {true, false})
    {
      int placement = winnersRow ? winnerPlacement : loserPlacement;
      TournamentCell& cell = cells[placement][round];
      cell.present = true;
      cell.opponent = winnersRow ? loser : winner;
      cell.result = jigo ? String("JIGO") : winnersRow ? String("WIN") : String("LOSS");
      cell.hasSgf = row["has_sgf"] == "1";
      cell.gameId = row["game_id"];
      placements[placement] = Optional<PlayerRef>(winnersRow ? winner : loser);
    }
  }

  html::SafeHtml roundHeaders;
  for (int round = 1; round <= rounds; ++round)
    roundHeaders.append(roundHeaderTemplate.render({{"round", round}}));
  html::SafeHtml rows;
  for (int placement = 1; placement <= players; ++placement)
  {
    if (!placements[placement].has_value())
      continue;
    html::SafeHtml roundCells;
    for (int round = 1; round <= rounds; ++round)
    {
      const TournamentCell& cell = cells[placement][round];
      html::SafeHtml content;
      if (cell.present)
      {
        if (canEditAnyGame(page))
        {
          content.append(editGameLinkTemplate.render({{"id", cell.gameId}, {"redirect", String("/tournament?id=") + id}}));
          content.append(html::SafeHtml::trusted(" "));
        }
        content.append(resultImage(page, cell.result));
        content.append(html::SafeHtml::trusted(" "));
        content.append(playerLink(cell.opponent));
        if (cell.hasSgf)
        {
          content.append(html::SafeHtml::trusted(" "));
          content.append(sgfLink(cell.gameId));
        }
      }
      roundCells.append(plainCellTemplate.render({{"content", content}}));
    }
    rows.append(placementRowTemplate.render({{"placement", placement}, {"player", playerLink(*placements[placement])}, {"cells", roundCells}}));
  }
  page.body.append(tournamentTemplate.render({{"name", tournament["name"]},
                                              {"egd", egdTournamentLink(tournament["egd_key"])},
                                              {"date", showDate(tournament["timestamp"], false)},
                                              {"type", tournament["game_type_name"]},
                                              {"players", tournament["player_count"]},
                                              {"country", tournament["country_name"]},
                                              {"city", tournament["city"]},
                                              {"rounds", roundHeaders},
                                              {"rows", rows}}));
}
