// Recomputing ratings after a game changed (src/process_rating_update_helper.php,
// src/rating_helper.php's fetchUserRatingBefore). The database's triggers start an update when a
// game is deleted, restored or edited: the variables rating_update_in_progress,
// rating_update_timestamp and rating_update_version, and rating_update_value with the rating each
// player had before the change. Each iteration takes the earliest game after that time that the
// update has not seen yet, recomputes its two ratings and moves the players' values on; the last
// one copies the values into user.rating.
//
// Ported from PHP, so the database gets the same values: a rating read from the database goes back
// as its text, a computed one as PHP printed its doubles (phpNumber). Differences on purpose:
// - a player's rating before a game is read from their latest earlier game that is not deleted; PHP
//   read deleted ones too (kovarex, 2026-11-02: "deleted games are deleted, they don't count");
// - a game is recomputed as it was computed in the first place (kovarex, 2026-11-03), where PHP's
//   recomputation differed: a jigo is half a win for both players (PHP: a win and a loss), and a
//   player with no rating before the game starts from the rating the game was computed with (in a
//   tournament, EGD's before it, as processTournament takes the opponent's; else the game's old
//   rating, the report's), where PHP took 0; a tournament's game is computed from the ratings before
//   the tournament, as processTournament does (tournamentSide), where PHP chained the update's
//   values, which went wrong when the update reached a later round first (the rounds share one
//   time). A tournament processed again notes any difference left (rating_discrepancy).

// A column's PHP truthiness: NULL, "" and "0" are false.
bool phpTrue(const Optional<String>& value) { return value.has_value() && !value->empty() && *value != "0"; }

// The player's rating before timestamp, not counting games of tournament (fetchUserRatingBeforeFromUser):
// their latest game's new rating (the EGD one with egdOnly, or when the other is NULL), else the
// rating they registered with, else lastResort.
Optional<String> fetchUserRatingBefore(Page& page, const Row& user, StringView userId, const Optional<String>& timestamp,
                                       const Optional<String>& tournamentId, const Optional<String>& lastResort, bool egdOnly)
{
  String id(userId);
  String sql = String("SELECT IF(game.winner_user_id=") + id + ", game.winner_new_rating, game.loser_new_rating) as rating,"
               " IF(game.winner_user_id=" + id + ", game.winner_new_egd_rating, game.loser_new_egd_rating) as egd_rating"
               " FROM game WHERE game.deleted = false and (game.winner_user_id=" + quote(id) + " or game.loser_user_id=" + quote(id) + ")";
  if (phpTrue(timestamp))
    sql.append(String(" and game.timestamp < ") + quote(*timestamp));
  if (phpTrue(tournamentId))
    sql.append(String(" and (game.egd_tournament_id is null or game.egd_tournament_id != ") + quote(*tournamentId) + ")");
  if (egdOnly)
    sql.append(String(" and IF(game.winner_user_id=") + id + ", game.winner_new_egd_rating, game.loser_new_egd_rating) is not null");
  // (the id last: two games of one time and round, two reports of the same second, in one order)
  sql.append(" ORDER BY game.timestamp DESC, game.egd_tournament_round DESC, game.id DESC LIMIT 1");
  mariadb::MariaDbResult last = page.query(sql);
  if (last.empty())
  {
    if (!user.isNull("register_rating") && phpTrue(Optional<String>(user["register_rating"])))
      return Optional<String>(user["register_rating"]);
    return lastResort;
  }
  if (!egdOnly && last.at(0, "rating").has_value())
    return last.at(0, "rating");
  return last.at(0, "egd_rating");
}

Optional<String> fetchUserRatingBefore(Page& page, StringView userId, const Optional<String>& timestamp,
                                       const Optional<String>& tournamentId, const Optional<String>& lastResort = Optional<String>())
{
  mariadb::MariaDbResult user = page.query(String("SELECT * FROM user where id=") + quote(userId));
  if (user.empty())
    throw GoratingError(format("no user {}", userId));
  return fetchUserRatingBefore(page, Row(user, 0), userId, timestamp, tournamentId, lastResort, false);
}

// The rating a player's game starts from: the update's value for them or the game's own, whichever
// is from the later time (getRatingToUse).
String ratingToUse(const Optional<String>& rating, const Optional<String>& ratingTimestamp, const Optional<String>& gameRating,
                   StringView gameTimestamp)
{
  if (!rating.has_value() || rating->empty())
  {
    if (!gameRating.has_value())
      throw GoratingError("a rating update without a rating for the game");
    return *gameRating;
  }
  if (!gameRating.has_value() || gameRating->empty())
    return *rating;
  return ratingTimestamp.has_value() && *ratingTimestamp <= gameTimestamp ? *rating : *gameRating;
}

// The rating a player's side of a game is computed from: their rating before it, not counting its
// tournament; with none, the one the game was first computed with (a tournament's: EGD's rating of
// them before it, their first round's old EGD rating, as processTournament takes an opponent's from
// the page; a reported game's: its old rating for them). As the database has it, text.
String ratingForCalculation(Page& page, StringView userId, StringView gameTimestamp, const Optional<String>& tournament,
                            const Optional<String>& gameOldRating)
{
  // A tournament's games all start from the ratings before it, which tournamentSide asks for again
  // for every game and opponent (5 rounds: 6 lookups a game): looked up once per request. An update
  // goes on in time order, so what is before the tournament no longer changes when it is reached.
  Optional<String> before;
  String key = phpTrue(tournament) ? format("{} {} {}", userId, *tournament, gameTimestamp) : String();
  auto cached = key.empty() ? page.ratingsBeforeTournament.end() : page.ratingsBeforeTournament.find(key);
  if (cached != page.ratingsBeforeTournament.end())
    before = cached->second;
  else
  {
    before = fetchUserRatingBefore(page, userId, Optional<String>(String(gameTimestamp)), tournament);
    if ((!before.has_value() || before->empty()) && phpTrue(tournament))
    {
      String id(userId);
      before = page.db->scalar(String("SELECT IF(winner_user_id=") + id +
                               ", winner_old_egd_rating, loser_old_egd_rating) FROM game WHERE egd_tournament_id=" + quote(*tournament) +
                               " and (winner_user_id=" + quote(id) + " or loser_user_id=" + quote(id) + ") ORDER BY egd_tournament_round, id LIMIT 1");
    }
    if (!key.empty())
      page.ratingsBeforeTournament[key] = before;
  }
  if (before.has_value() && !before->empty())
    return *before;
  if (gameOldRating.has_value() && !gameOldRating->empty())
    return *gameOldRating;
  throw GoratingError(format("no rating to recompute user {}'s game from", userId));
}

struct TournamentSide
{
  String oldRating; // before the game
  String newRating; // after it
  String end;       // after the player's last game in the tournament
};

// A player's side of a game of a tournament, as processTournament computes it: from their rating
// before the tournament, each of their games in it that is not deleted, in round order, adds what
// the formula gives against the opponent's rating before the tournament. The rounds share one time,
// so an update can reach them in any order: nothing here depends on it.
TournamentSide tournamentSide(Page& page, StringView userId, StringView gameId, StringView tournament, StringView gameTimestamp)
{
  String id(userId);
  Optional<String> tournamentId(String(tournament));
  mariadb::MariaDbResult games = page.query(
      String("SELECT id, winner_user_id, loser_user_id, winner_old_rating, loser_old_rating, game_type_id, handicap, komi, winner_is_black,"
             " jigo FROM game WHERE deleted = false and egd_tournament_id=") +
      quote(tournament) + " and (winner_user_id=" + quote(id) + " or loser_user_id=" + quote(id) + ") ORDER BY egd_tournament_round, id");
  String startText = ratingForCalculation(page, userId, gameTimestamp, tournamentId, Optional<String>());
  double start = ratingValue(startText);
  double running = start;
  String runningText = startText;
  TournamentSide side;
  bool found = false;
  for (ContainerSize i = 0; i < games.size(); ++i)
  {
    Row game(games, i);
    bool won = game["winner_user_id"] == id;
    String opponent = won ? game["loser_user_id"] : game["winner_user_id"];
    double opponentStart = ratingValue(ratingForCalculation(page, opponent, gameTimestamp, tournamentId,
                                                            games.at(i, won ? "loser_old_rating" : "winner_old_rating")));
    bool black = won == phpTrue(games.at(i, "winner_is_black"));
    double handicap = ratingValue(game["handicap"]);
    double result = phpTrue(games.at(i, "jigo")) ? 0.5 : (won ? 1.0 : 0.0);
    double delta = calculateNewRating(start, opponentStart, result, (int)stoll(game["game_type_id"]), black ? handicap : -handicap,
                                      (black ? -1 : 1) * (ratingValue(game["komi"]) - 6.5)) -
                   start;
    String before = runningText;
    running = running + delta;
    runningText = phpNumber(running);
    if (game["id"] == gameId)
    {
      side.oldRating = before;
      side.newRating = runningText;
      found = true;
    }
  }
  if (!found)
    throw GoratingError(format("game {} is not among user {}'s games of its tournament", gameId, userId));
  side.end = runningText;
  return side;
}

String variable(Page& page, StringView name)
{
  Optional<String> value = page.db->scalar(String("SELECT value from variable WHERE name=") + quote(name));
  return value.has_value() ? *value : String();
}

// One iteration: true when the update is finished.
// How long a request moves a rating update on (kovarex, 2026-11-04: "go as much as you can in 20
// seconds"; PHP did 50 games), and the games in each of its transactions: a request stopped half way
// keeps what it committed.
constexpr int ratingUpdateSeconds = 20;
constexpr int ratingUpdateGamesPerTransaction = 50;
// The players the "Rating changes" list names; an update can change thousands.
constexpr ContainerSize ratingChangesShown = 30;

// header, then a line each, the first limit of them and how many more there are.
String limitedLines(StringView header, const Vector<String>& lines, ContainerSize limit, StringView more)
{
  String out(header);
  for (ContainerSize i = 0; i < lines.size() && i < limit; ++i)
    out.append(String("\n") + lines[i]);
  if (lines.size() > limit)
    out.append(format("\n... and {} more {}.", (int64_t)(lines.size() - limit), more));
  return out;
}

// One game of the update in progress (processRatingIteration in PHP); true when none is left and the
// update finished, with what it changed in finishedReport. reached is the time of the game done.
bool processRatingIteration(Page& page, String& finishedReport, String& reached)
{
  String version = variable(page, "rating_update_version");
  String since = variable(page, "rating_update_timestamp");
  String part = String(" FROM rating_update_value JOIN game ON rating_update_value.user_id=game.");
  // A player's games count from the time they entered the update (kovarex, 2026-11-05): one who
  // joins it at a later game (an opponent of a player it changed) has their games from that game on
  // computed again, not their earlier ones, so the update goes forward in time and a tournament's
  // ratings before it are fixed once it is reached. PHP took every game of theirs since the update's
  // start, going back in time after later games (a tournament's rounds then started from different
  // ratings, and the result depended on the order).
  String common = String(" WHERE game.deleted = false and game.rating_update_version < ") + version +
                  " and game.timestamp >= " + quote(since) + " and game.timestamp >= rating_update_value.timestamp";
  mariadb::MariaDbResult found = page.query(
      String("SELECT game_id, winner_user_id, loser_user_id, MAX(winner_rating) as winner_rating,"
             " MAX(winner_rating_timestamp) as winner_rating_timestamp, game_winner_rating, MAX(loser_rating) as loser_rating,"
             " MAX(loser_rating_timestamp) as loser_rating_timestamp, game_loser_rating, game_timestamp, game_type_id,"
             " game_handicap, game_komi, game_winner_is_black, game_egd_tournament_id, game_jigo FROM ("
             "SELECT game.id as game_id, game.winner_user_id as winner_user_id, rating_update_value.rating as winner_rating,"
             " rating_update_value.timestamp as winner_rating_timestamp, game.winner_old_rating as game_winner_rating,"
             " game.loser_user_id as loser_user_id, NULL as loser_rating, NULL as loser_rating_timestamp,"
             " game.loser_old_rating as game_loser_rating, game.timestamp as game_timestamp, game.game_type_id as game_type_id,"
             " game.handicap as game_handicap, game.komi as game_komi, game.winner_is_black as game_winner_is_black,"
             " game.egd_tournament_id as game_egd_tournament_id, game.egd_tournament_round as game_egd_tournament_round,"
             " game.jigo as game_jigo") +
      part + "winner_user_id" + common +
      " UNION SELECT game.id as game_id, game.winner_user_id as winner_user_id, NULL as winner_rating,"
      " NULL as winner_rating_timestamp, game.winner_old_rating as game_winner_rating, game.loser_user_id as loser_user_id,"
      " rating_update_value.rating as loser_rating, rating_update_value.timestamp as loser_rating_timestamp,"
      " game.loser_old_rating as game_loser_rating, game.timestamp as game_timestamp, game.game_type_id as game_type_id,"
      " game.handicap as game_handicap, game.komi as game_komi, game.winner_is_black as game_winner_is_black,"
      " game.egd_tournament_id as game_egd_tournament_id, game.egd_tournament_round as game_egd_tournament_round,"
      " game.jigo as game_jigo" +
      part + "loser_user_id" + common +
      ") as tmp GROUP BY game_id ORDER BY game_timestamp, game_egd_tournament_id, game_egd_tournament_round, game_id LIMIT 1");
  if (found.empty())
  {
    // Each player's rating from their latest game, as processing a tournament sets it (PHP copied
    // the update's value, which a player without gorating ratings has only to be visited by it).
    // The rating each player had and has (PHP's reportRatingFinishedResults: its "Rating changes"
    // table, in the message of the request that finishes the update).
    mariadb::MariaDbResult users = page.query("SELECT user.id AS id, user.name AS name, user.rating AS rating FROM rating_update_value"
                                              " JOIN user ON user.id = rating_update_value.user_id ORDER BY user.name, user.id");
    Vector<String> changes;
    for (ContainerSize i = 0; i < users.size(); ++i)
    {
      Row user(users, i);
      updateFinalRating(page, user["id"]);
      Optional<String> now = page.db->scalar(String("SELECT rating FROM user WHERE id=") + quote(user["id"]));
      changes.push_back(user["name"] + ": " + showRating(user["rating"]) + "→" + showRating(now.value_or(String())));
    }
    finishedReport = limitedLines("Rating changes:", changes, ratingChangesShown, "players");
    page.query("DELETE FROM rating_update_value");
    page.query("update variable SET value='0' WHERE name='rating_update_in_progress'");
    return true;
  }
  Row row(found, 0);
  String gameId = row["game_id"];
  reached = row["game_timestamp"];
  String winnerId = row["winner_user_id"];
  String loserId = row["loser_user_id"];
  Optional<String> gameWinnerRating = found.at(0, "game_winner_rating");
  Optional<String> gameLoserRating = found.at(0, "game_loser_rating");
  if (!phpTrue(gameWinnerRating) && !phpTrue(gameLoserRating))
  {
    page.query(String("UPDATE game SET rating_update_version=") + version + " WHERE game.id=" + gameId);
    return false;
  }
  String gameTimestamp = row["game_timestamp"];
  int gameType = (int)stoll(row["game_type_id"]);
  Optional<String> tournament = found.at(0, "game_egd_tournament_id");
  String gameTime = String("STR_TO_DATE(") + quote(gameTimestamp) + ",'%Y-%m-%d %H:%i:%s')";
  if (phpTrue(tournament))
  {
    // Each side as processTournament computes it; the player's update value is their rating after
    // the tournament, which their later games start from.
    String set;
    for (StringView prefix : {"winner", "loser"})
    {
      String p(prefix);
      if (!phpTrue(prefix == "winner" ? gameWinnerRating : gameLoserRating))
        continue;
      String userId = prefix == "winner" ? winnerId : loserId;
      TournamentSide side = tournamentSide(page, userId, gameId, *tournament, gameTimestamp);
      set.append(p + "_old_rating=" + side.oldRating + "," + p + "_new_rating=" + side.newRating + ",");
      page.query(String("CALL add_or_force_update_user_rating_update_value(") + userId + "," + side.end + "," + gameTime + ")");
    }
    page.query(String("UPDATE game SET ") + set + " rating_update_version=" + version + " WHERE game.id=" + gameId);
    return false;
  }
  double winnerForCalculation = ratingValue(ratingForCalculation(page, winnerId, gameTimestamp, tournament, gameWinnerRating));
  double loserForCalculation = ratingValue(ratingForCalculation(page, loserId, gameTimestamp, tournament, gameLoserRating));
  bool jigo = phpTrue(found.at(0, "game_jigo"));
  bool winnerIsBlack = phpTrue(found.at(0, "game_winner_is_black"));
  double winnerExtraHandicap = (winnerIsBlack ? 1 : -1) * ratingValue(row["game_handicap"]);
  double winnerExtraKomi = (winnerIsBlack ? -1 : 1) * (ratingValue(row["game_komi"]) - 6.5);

  String set;
  Optional<String> winnerNew;
  Optional<String> loserNew;
  if (phpTrue(gameWinnerRating))
  {
    String old = ratingToUse(found.at(0, "winner_rating"), found.at(0, "winner_rating_timestamp"), gameWinnerRating, gameTimestamp);
    double delta = calculateNewRating(winnerForCalculation, loserForCalculation, jigo ? 0.5 : 1.0, gameType, winnerExtraHandicap, winnerExtraKomi) -
                   winnerForCalculation;
    winnerNew = Optional<String>(phpNumber(ratingValue(old) + delta));
    set.append(String("winner_old_rating=") + old + ",winner_new_rating=" + *winnerNew + ",");
  }
  if (phpTrue(gameLoserRating))
  {
    String old = ratingToUse(found.at(0, "loser_rating"), found.at(0, "loser_rating_timestamp"), gameLoserRating, gameTimestamp);
    double delta = calculateNewRating(loserForCalculation, winnerForCalculation, jigo ? 0.5 : 0.0, gameType, -winnerExtraHandicap, -winnerExtraKomi) -
                   loserForCalculation;
    loserNew = Optional<String>(phpNumber(ratingValue(old) + delta));
    set.append(String("loser_old_rating=") + old + ",loser_new_rating=" + *loserNew + ",");
  }
  page.query(String("UPDATE game SET ") + set + " rating_update_version=" + version + " WHERE game.id=" + gameId);
  if (winnerNew.has_value())
    page.query(String("CALL add_or_force_update_user_rating_update_value(") + winnerId + "," + *winnerNew + "," + gameTime + ")");
  if (loserNew.has_value())
    page.query(String("CALL add_or_force_update_user_rating_update_value(") + loserId + "," + *loserNew + "," + gameTime + ")");
  return false;
}

// A rating update in progress moved on for up to seconds, ratingUpdateGamesPerTransaction games a
// transaction (processRating). The result says how far it got, for the message after a game was
// deleted, restored or edited, and for the jobs: the players' changes when it finished, else the
// time of the last game done and how many later games are left to look at (at most that many are
// recomputed: those of players the update has not reached yet are only passed).
String processRating(Page& page, int seconds)
{
  int64_t until = unixNow() + seconds;
  int processed = 0;
  bool finished = false;
  String report;
  String reached;
  for (;;)
  {
    // Kept for one transaction: another request's edit may start the update again in between.
    page.ratingsBeforeTournament.clear();
    page.db->begin();
    if (variable(page, "rating_update_in_progress") != "1")
    {
      // None, or another request finished it meanwhile.
      page.db->commit();
      if (processed == 0)
        return "No rating changes to process.";
      finished = true;
      break;
    }
    for (int i = 0; i < ratingUpdateGamesPerTransaction && !finished; ++i)
    {
      finished = processRatingIteration(page, report, reached);
      if (!finished)
        ++processed;
    }
    page.db->commit();
    if (finished || unixNow() >= until)
      break;
  }
  if (finished)
    return format("Rating update finished after {} games.\n", processed) + report;
  String version = variable(page, "rating_update_version");
  if (reached.empty())
    reached = variable(page, "rating_update_timestamp");
  Optional<String> left = page.db->scalar(String("SELECT COUNT(*) FROM game WHERE deleted = false and rating_update_version < ") + version +
                                          " and timestamp >= " + quote(reached));
  return format("Rating update: {} games recomputed in this request, up to the games of {}; {} later games are left to look at"
                " (the next edit or the hourly job goes on).",
                processed, reached, left.value_or(String("0")));
}
