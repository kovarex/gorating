// Recomputing ratings against processing a tournament (testdata/recompute-check.sh's checks, kovarex
// 2026-11-03: "recomputing needs to be fixed so it is inline with how it is normally computed"):
// a made-up tournament (EgdTests.kpp's markup) processed by its job from saved pages, with half its
// players registered before it; a recompute from its start moves no game; a deleted game starts an
// update and processing the tournament again finds no discrepancy; two changes keep the earlier
// start; a tournament added after a later game recomputes that game from the tournament's end.

// A made-up player of the tournament: EGD's pin, name and GoR before it.
struct MadeUpPlayer
{
  const char* pin;
  const char* name;
  const char* gor;
};

// A game of it, as the first player's row: the round, the result and colour for the first player,
// the handicap cell, and EGD's GoR changes of the two.
struct MadeUpGame
{
  int round;
  int a;
  int b;
  const char* result;
  const char* color;
  const char* handicap;
  const char* changeA;
  const char* changeB;
};

constexpr MadeUpPlayer madeUpPlayers[] = {{"19990001", "Ada Testová", "2100"}, {"19990002", "Bea Example", "1900"},
                                          {"19990003", "Cyril van Mock", "1700"}, {"19990004", "Dana Sample", "1500"}};
constexpr MadeUpGame madeUpGames[] = {{1, 0, 1, "Win", "w", "0 explicit", "4.1", "-4.1"},  {1, 2, 3, "Loss", "b", "0 explicit", "-6.2", "6.2"},
                                      {2, 0, 2, "Win", "b", "0 explicit", "2.5", "-2.5"},  {2, 1, 3, "Jigo", "w", "0 explicit", "-1.3", "1.3"},
                                      {3, 0, 3, "Loss", "w", "2 explicit", "-9.8", "9.8"}, {3, 1, 2, "Win", "b", "0 explicit", "3.6", "-3.6"}};

// The tournament's GoR page: each player's block with their games from their side.
String madeUpTournament()
{
  String blocks;
  for (int p = 0; p < 4; ++p)
  {
    String rows;
    for (const MadeUpGame& g : madeUpGames)
    {
      if (g.a != p && g.b != p)
        continue;
      bool first = g.a == p;
      const MadeUpPlayer& other = madeUpPlayers[first ? g.b : g.a];
      StringView result = first ? StringView(g.result) : StringView(g.result) == "Win" ? StringView("Loss") : StringView(g.result) == "Loss" ? StringView("Win") : StringView("Jigo");
      StringView color = first ? StringView(g.color) : StringView(g.color) == "w" ? StringView("b") : StringView("w");
      rows.append(egdGameRow(format("{}", g.round), first ? g.changeA : g.changeB, color, g.handicap, result, other.pin, other.name, other.gor,
                             first ? g.changeB : g.changeA));
    }
    blocks.append(egdPlayerBlock(p + 1, madeUpPlayers[p].pin, madeUpPlayers[p].name, madeUpPlayers[p].gor, rows));
  }
  return egdTournamentPage(blocks, "", "Czechia (CZ)", "A (1x)");
}

constexpr StringView madeUpKey = "T261031Z";
constexpr StringView egdWork = "testdata/egd-work";

// The saved pages the job reads (egdPageDirectory): the tournament's and each player's card.
void saveMadeUpPages()
{
  filesystem::create_directories(filesystem::path(String(egdWork)));
  writeTestFile(String(egdWork) + "/" + egdPageName(String(egdAddress) + "Tournament_ShowGoR.php?key=" + madeUpKey, ""), madeUpTournament());
  for (const MadeUpPlayer& p : madeUpPlayers)
    writeTestFile(String(egdWork) + "/" + egdPageName(String(egdAddress) + "Player_Card.php?&key=" + p.pin, ""),
                  format("<form><input name=\"gor\" value=\"{} (x)\"><input name=\"country\" value=\"Czechia (CZ)\"></form>", StringView(p.gor)));
}

String dbValue(const GoratingConfig& config, StringView sql) { return goratingDbValue(config, sql); }

void dbRun(const GoratingConfig& config, StringView sql)
{
  mariadb::MariaDbConnection db = mariadb::MariaDbConnection::connect(config.database);
  runSqlScript(db, sql);
}

String processMadeUpTournament(const GoratingConfig& config)
{
  return siteRequest(config, "owner", "GET", String("/process_tournament?egd_tournament_key=") + madeUpKey).body;
}

// The tournament's games' gorating ratings, a line each.
String madeUpRatings(const GoratingConfig& config, StringView tournament)
{
  mariadb::MariaDbConnection db = mariadb::MariaDbConnection::connect(config.database);
  mariadb::MariaDbResult games = db.query(String("SELECT id, winner_old_rating, winner_new_rating, loser_old_rating, loser_new_rating FROM game"
                                                 " WHERE egd_tournament_id=") + tournament + " ORDER BY id");
  String out;
  for (ContainerSize i = 0; i < games.size(); ++i)
  {
    for (const String& column : games.columns)
    {
      const Optional<String>& v = games.at(i, column);
      // Rounded to 1e-6: a recompute writes the same double, which MariaDB may print otherwise.
      out.append(v.has_value() ? (column == "id" ? *v : phpNumber(round(ratingValue(*v) * 1e6) / 1e6)) : String("NULL"));
      out.append(" ");
    }
    out.append("\n");
  }
  return out;
}

void runRatingUpdate(const GoratingConfig& config)
{
  for (int i = 0; i < 20 && dbValue(config, "SELECT value FROM variable WHERE name='rating_update_in_progress'") != "0"; ++i)
    siteRequest(config, "owner", "GET", "/update_rating");
}

test "recomputing agrees with processing a tournament"
{
  Optional<mariadb::MariaDbOptions> server = testDatabaseServer();
  if (!server.has_value())
  {
    println("skipped: GORATING_TEST_DB is not set (src/tests/TestDatabase.kpp)");
    return;
  }
  GoratingConfig config = freshTestDatabase(*server);
  saveMadeUpPages();
  config.egdPageDirectory = String(egdWork);
  check(processMadeUpTournament(config).find("Processed") != String::npos);
  String t = dbValue(config, String("SELECT id FROM egd_tournament WHERE egd_key=") + quote(madeUpKey));
  require(!t.empty());
  check(dbValue(config, String("SELECT COUNT(*) FROM game WHERE egd_tournament_id=") + t) == "6");
  check(dbValue(config, String("SELECT COUNT(*) FROM game WHERE jigo AND egd_tournament_id=") + t) == "1");

  // Every other player registered before it, from EGD's rating; processed again from nothing, their
  // games get gorating ratings.
  dbRun(config, String("UPDATE user SET register_timestamp='2026-01-01 00:00:00', register_rating=egd_rating, rating=egd_rating"
                       " WHERE egd_pin IN ('19990001', '19990003');"
                       "DELETE FROM game WHERE egd_tournament_id=") + t + "; DELETE FROM egd_tournament_result WHERE egd_tournament_id=" + t +
                 "; DELETE FROM egd_tournament WHERE id=" + t);
  check(processMadeUpTournament(config).find("Processed") != String::npos);
  t = dbValue(config, String("SELECT id FROM egd_tournament WHERE egd_key=") + quote(madeUpKey));
  check(dbValue(config, String("SELECT COUNT(*) FROM game WHERE egd_tournament_id=") + t +
                         " AND (winner_old_rating IS NOT NULL OR loser_old_rating IS NOT NULL)") == "5");
  String processed = madeUpRatings(config, t);

  // A recompute from the tournament's start moves no game.
  for (StringView pin : {"19990001", "19990003"})
  {
    String id = dbValue(config, String("SELECT id FROM user WHERE egd_pin=") + quote(pin));
    String rating = String("(SELECT register_rating FROM user WHERE id=") + id + ")";
    dbRun(config, String("CALL start_rating_update(") + id + ", " + rating + ", " + id + ", " + rating +
                      ", (SELECT timestamp FROM egd_tournament WHERE id=" + t + "))");
  }
  check(dbValue(config, "SELECT value FROM variable WHERE name='rating_update_in_progress'") == "1");
  runRatingUpdate(config);
  check(madeUpRatings(config, t) == processed);

  // A deleted game whose winner has no gorating rating and whose loser has one starts an update;
  // after it, processing the tournament again finds nothing different.
  String deleted = dbValue(config, String("SELECT id FROM game WHERE egd_tournament_id=") + t +
                                      " AND winner_old_rating IS NULL AND loser_old_rating IS NOT NULL ORDER BY egd_tournament_round LIMIT 1");
  require(!deleted.empty());
  dbRun(config, String("UPDATE game SET deleted=1 WHERE id=") + deleted);
  check(dbValue(config, "SELECT value FROM variable WHERE name='rating_update_in_progress'") == "1");
  runRatingUpdate(config);
  dbRun(config, "DELETE FROM rating_discrepancy");
  processMadeUpTournament(config);
  check(dbValue(config, "SELECT COUNT(*) FROM rating_discrepancy") == "0");

  // Two changes while an update is in progress: it starts at the earlier.
  dbRun(config, "CALL start_rating_update(1, 1500, 1, 1500, '2026-10-30 00:00:00'); CALL start_rating_update(1, 1500, 1, 1500, '2027-01-01 00:00:00')");
  check(dbValue(config, "SELECT value FROM variable WHERE name='rating_update_timestamp'") == "2026-10-30 00:00:00");
  runRatingUpdate(config);

  // A tournament added after a later game was computed: that game is recomputed from the
  // tournament's end.
  String a = dbValue(config, "SELECT id FROM user WHERE egd_pin='19990001'");
  String b = dbValue(config, "SELECT id FROM user WHERE egd_pin='19990003'");
  dbRun(config, format("INSERT INTO game(winner_user_id, loser_user_id, game_type_id, timestamp, winner_old_rating, winner_new_rating, loser_old_rating,"
                       " loser_new_rating) VALUES({}, {}, 5, '2026-11-01 00:00:00', 1500, 1510, 1500, 1490)", a, b));
  String later = dbValue(config, "SELECT MAX(id) FROM game");
  dbRun(config, String("DELETE FROM game WHERE egd_tournament_id=") + t + "; DELETE FROM egd_tournament_result WHERE egd_tournament_id=" + t +
                 "; DELETE FROM egd_tournament WHERE id=" + t);
  processMadeUpTournament(config);
  t = dbValue(config, String("SELECT id FROM egd_tournament WHERE egd_key=") + quote(madeUpKey));
  check(dbValue(config, "SELECT value FROM variable WHERE name='rating_update_in_progress'") == "1");
  runRatingUpdate(config);
  auto lastOf = [&](StringView user)
  {
    String u(user);
    return dbValue(config, String("SELECT IF(winner_user_id=") + u + ", winner_new_rating, loser_new_rating) FROM game WHERE egd_tournament_id=" + t +
                               " AND deleted=0 AND (winner_user_id=" + u + " OR loser_user_id=" + u + ") ORDER BY egd_tournament_round DESC LIMIT 1");
  };
  check(nearly(ratingValue(dbValue(config, String("SELECT winner_old_rating FROM game WHERE id=") + later)), ratingValue(lastOf(a))));
  check(nearly(ratingValue(dbValue(config, String("SELECT loser_old_rating FROM game WHERE id=") + later)), ratingValue(lastOf(b))));
  check(nearly(ratingValue(dbValue(config, String("SELECT rating FROM user WHERE id=") + a)),
               ratingValue(dbValue(config, String("SELECT winner_new_rating FROM game WHERE id=") + later))));
}
