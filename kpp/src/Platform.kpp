// What gorating needs from the operating system that kpp's standard library does not have yet: a
// cryptographically secure random source (RandomDevice is not one), and a process to write mail to.

extern "C" unsigned char SystemFunction036(void* buffer, unsigned long length); // RtlGenRandom, advapi32
extern "C" void arc4random_buf(void* buffer, size_t length);                     // FreeBSD, glibc 2.36+
extern "C" FILE* _popen(const char* command, const char* mode);
extern "C" int _pclose(FILE* stream);
extern "C" FILE* popen(const char* command, const char* mode);
extern "C" int pclose(FILE* stream);

// n bytes from the operating system's secure random source.
String secureRandomBytes(int n)
{
  String out(n, '\0');
  if constexpr (config::platform == Platform::Windows)
  {
    if (!SystemFunction036(out.data(), (unsigned long)n))
      throw GoratingError("RtlGenRandom failed");
  }
  else
    arc4random_buf(out.data(), (size_t)n);
  return out;
}

// A secret for an invite or a password reset: the columns hold an int, so 31 random bits.
int64_t secureRandomSecret()
{
  String bytes = secureRandomBytes(4);
  uint32_t value = 0;
  for (int i = 0; i < 4; ++i)
    value = (value << 8) | (uint8_t)bytes[i];
  return (int64_t)(value & 0x7fffffffu);
}

// Runs command with text on its standard input; its exit code.
int runWithInput(StringView command, StringView text)
{
  String line(command);
  FILE* pipe = nullptr;
  if constexpr (config::platform == Platform::Windows)
    pipe = _popen(line.c_str(), "wb");
  else
    pipe = popen(line.c_str(), "w");
  if (pipe == nullptr)
    throw GoratingError(format("cannot run {}", command));
  fwrite(text.data(), 1, text.size(), pipe);
  if constexpr (config::platform == Platform::Windows)
    return _pclose(pipe);
  else
    return pclose(pipe);
}
